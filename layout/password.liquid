<!doctype html>
<html class="no-js full-height" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">

    <meta name="theme-color" content="#ffffff">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">

    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>{{ shop.name }}</title>

    <meta name="description" content="{{ page_description | escape }}">

    {% render 'meta-tags' %}

    <script src="{{ 'base-script.min.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'password-script.min.js' | asset_url }}" defer="defer"></script>

    {{ content_for_header }}

    {%- render 'custom-properties' -%}
    {%- render 'fonts' -%}

    {{ 'base-style.css' | asset_url | stylesheet_tag }}
    {{ 'password-modal-style.css' | asset_url | stylesheet_tag }}
  </head>

  {%- assign requestedPageType = request.page_type | handle -%}

  <body class="template-{{ requestedPageType }} {% if template contains '.' %}template-{{ template | replace: '.', '-' }}{% endif %}">
    {%- section 'main-password-header' -%}

    <main id="MainContent" class="password-main content-for-layout">
      {{ content_for_layout }}
    </main>

    <div class="o-footer-group--align-bottom">
      {%- section 'main-password-footer' -%}
    </div>
  </body>
</html>
