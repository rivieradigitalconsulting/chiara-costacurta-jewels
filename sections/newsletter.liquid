{%- render '_styles-section', section: section -%}
{{ 'newsletter-style.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign color_scheme = section.settings.color_scheme
  assign standard_color_scheme = settings.color_schemes['scheme-1']

  assign is_allowed_to_show = true

  if request.page_type == 'index' and section.settings.hide_on_homepage == true
    assign is_allowed_to_show = false
  endif

  unless section.settings.enable_newsletter
    assign is_allowed_to_show = false
  endunless
-%}

{%- if is_allowed_to_show -%}
  <div
    class="o-newsletter o-section u-color--{{ color_scheme }}"
    {% if section.settings.invert_navigation_color %}
      data-invert-navigation
    {% endif %}
    {% if section.settings.section_id != blank %}
      id="{{ section.settings.section_id | handleize }}"
    {% endif %}
  >
    <div class="o-newsletter__inner o-section__constrict">
      <div class="o-newsletter__content u-position-{{ section.settings.content_position }} u-text-{{ section.settings.content_alignment }}">
        {%- liquid
          for block in section.blocks
            capture block_styles
              render '_styles-blocks', block: block
            endcapture
            case block.type
              when 'caption'
                render 'block-caption', block: block, block_styles: block_styles, block_class: 'o-newsletter__caption'
              when 'heading'
                render 'block-heading', block: block, block_styles: block_styles, block_class: 'o-newsletter__heading'
              when 'paragraph'
                render  'block-text', block: block, block_styles: block_styles, block_class: 'o-newsletter__text'
              when 'button'
                if block.settings.btn_label != blank
                  render 'block-button', block: block, block_styles: block_styles, block_class: 'o-newsletter__button'
                endif
              when 'email_form'
                render 'block-email-form', section: section, block: block, block_styles: block_styles, block_class: 'o-newsletter__email-form'
              when 'html'
                render 'block-html', block: block, block_styles: block_styles, block_class: 'o-newsletter__html'
            endcase
          endfor
        -%}
      </div>
    </div>
  </div>
{%- endif -%}

