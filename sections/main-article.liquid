{%- render '_styles-section', section: section -%}
{{ 'article-style.css' | asset_url | stylesheet_tag }}

{%- liquid
  if section.index == 1
    assign fetch_priority = 'high'
  endif
-%}

<div
  class="t-article o-section"
  itemscope
  itemtype="http://schema.org/BlogPosting"
  {% if section.settings.invert_navigation_color %}
    data-invert-navigation
  {% endif %}
  {% if section.settings.section_id != blank %}
    id="{{ section.settings.section_id | handleize }}"
  {% endif %}
>
  <div class="o-section__constrict">
    <div class="t-article__inner">
      <div class="grid grid--{{ section.settings.content_position }}-h">
        <div class="grid__col-12 grid__col-md-{{ section.settings.column_width }} u-text-{{ section.settings.content_alignment }}">
          <div class="t-article__breadcrumbs {% if settings.enable_animation %}js-animation a-animation a-animation--fade-up{% endif %}">
            {%- render 'breadcrumbs' -%}
          </div>

          {%- for block in section.blocks -%}
            {%- liquid
              capture block_styles
                render '_styles-blocks', block: block
              endcapture
            -%}
            {%- case block.type -%}
              {%- when '@app' -%}
                {% render block %}
              {%- when 'tags' -%}
                <div
                  class="t-article__tags a-spacing-content {% if settings.enable_animation %}js-animation a-animation a-animation--fade-up{% endif %}"
                  style="{{ block_styles | strip_newlines | remove: ' ' }}"
                  {{ block.shopify_attributes }}
                >
                  {%- for tag in article.tags -%}
                    <div class="t-article__tag">
                      <span>{{ tag }}</span>
                    </div>
                  {%- endfor -%}
                </div>
              {%- when 'featured_image' -%}
                {%- liquid
                  assign sizes = '100vw'
                  assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
                  assign aspect_ratio_class = 'a-img__ratio--' | append: block.settings.image_ratio
                -%}
                {%- if article.image -%}
                  <div
                    class="t-article__image t-article__image--{{ block.settings.image_height }} a-spacing-content {% if settings.enable_animation %}js-animation a-animation a-animation--fade-up{% endif %}"
                    style="{{ block_styles | strip_newlines | remove: ' ' }}"
                    {{ block.shopify_attributes }}
                  >
                    {{
                      article.image
                      | image_url: width: 2000
                      | image_tag:
                        sizes: sizes,
                        widths: widths,
                        fetchpriority: fetch_priority,
                        class: aspect_ratio_class,
                        loading: 'lazy'
                    }}
                  </div>
                {%- endif -%}
              {%- when 'heading' -%}
                <h1
                  class="t-article__heading {{ block.settings.heading_size }} a-spacing-content {% if settings.enable_animation %}js-animation a-animation a-animation--fade-up{% endif %}"
                  style="{{ block_styles | strip_newlines | remove: ' ' }}"
                  {{ block.shopify_attributes }}
                >
                  {{ article.title | escape }}
                </h1>
              {%- when 'info' -%}
                <div
                  class="t-article__info a-spacing-content grid--{{ section.settings.content_alignment }}-h {% if settings.enable_animation %}js-animation a-animation a-animation--fade-up{% endif %}"
                  style="{{ block_styles | strip_newlines | remove: ' ' }}"
                  {{ block.shopify_attributes }}
                >
                  {%- if block.settings.show_date -%}
                    <span class="t-article__date">
                      {%- comment -%}
                        Use time_tag filter to translate the date, when you want a custom format for example month_day_year that is added in locale files
                      {%- endcomment -%}
                      {{- article.published_at | time_tag: format: 'date' -}}
                    </span>
                  {%- endif -%}
                  {%- if block.settings.show_author -%}
                    <span class="t-article__date">
                      {{ article.author }}
                    </span>
                  {%- endif -%}
                </div>
              {%- when 'content' -%}
                <div
                  class="t-article__content rte a-spacing-content {% if settings.enable_animation %}js-animation a-animation a-animation--fade-up{% endif %}"
                  style="{{ block_styles | strip_newlines | remove: ' ' }}"
                  {{ block.shopify_attributes }}
                >
                  {{ article.content }}
                </div>
            {%- endcase -%}
          {%- endfor -%}

          {%- if blog.comments_enabled? -%}
            {%- render 'article-comments', section: section -%}
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>

{%- render 'article-seo-schema', article: article -%}

