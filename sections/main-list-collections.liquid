    {
      "type": "text_alignment",
      "id": "card_text_alignment",
      "label": "t:list_collections_page.settings.card_text_alignment.label",
      "default": "left"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:list_collections_page.settings.image_ratio.label",
      "options": [
        {
          "value": "default",
          "label": "t:sections.all.media_ratio.options.default.label"
        },
        {
          "value": "1x1",
          "label": "t:sections.all.media_ratio.options.1_x_1.label"
        },
        {
          "value": "2x3",
          "label": "t:sections.all.media_ratio.options.2_x_3.label"
        },
        {
          "value": "3x2",
          "label": "t:sections.all.media_ratio.options.3_x_2.label"
        },
        {
          "value": "4x3",
          "label": "t:sections.all.media_ratio.options.4_x_3.label"
        },
        {
          "value": "4x5",
          "label": "t:sections.all.media_ratio.options.4_x_5.label"
        },
        {
          "value": "16x9",
          "label": "t:sections.all.media_ratio.options.16_x_9.label"
        }
      ],
      "default": "default"
    },
    {
      "type": "header",
      "content": "t:list_collections_page.settings.header.content.content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:list_collections_page.settings.title.label",
      "default": "t:list_collections_page.settings.title.default"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:list_collections_page.settings.description.label",
      "default": "t:list_collections_page.settings.description.default"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "t:list_collections_page.blocks.collection.collection_item.name",
      "settings": [
        {
          "type": "header",
          "content": "t:list_collections_page.blocks.collection.collection_item.settings.header.general.content"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "t:list_collections_page.blocks.collection.collection_item.settings.collection.label"
        },
        {
          "type": "image_picker",
