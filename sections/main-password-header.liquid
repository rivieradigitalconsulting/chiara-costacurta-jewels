{%- liquid
  assign color_scheme = section.settings.color_scheme
-%}

<header class="o-header o-section u-color--{{ color_scheme }} o-header--password">
  <div class="o-header__inner">
    <div class="o-header__main">
      <div class="o-header__main-inner grid grid--no-wrap grid--center-v">
        <div class="o-header__logo a-logo">
          <a class="a-logo__link" href="{{ routes.root_url }}">
            {%- if settings.logo != blank -%}
              {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
              {% capture sizes %}(max-width: {{ settings.logo_width | times: 2 }}px) 50vw, {{ settings.logo_width }}px{% endcapture %}
              {% capture widths %}{{ settings.logo_width }}, {{ settings.logo_width | times: 1.5 | round }}, {{ settings.logo_width | times: 2 }}{% endcapture %}

              {{
                settings.logo
                | image_url: width: 600
                | image_tag:
                  class: 'o-header__logo-image',
                  widths: widths,
                  width: settings.logo_width,
                  alt: logo_alt,
                  sizes: sizes,
                  preload: true
              }}
            {%- else -%}
              <span class="h3">{{ shop.name }}</span>
            {%- endif -%}
          </a>
        </div>
        <div class="o-header__utilities">
          <a href="{{ routes.root_url }}" class="o-header__utility js-header-password">
            {%- render 'icon-padlock' -%}
          </a>
        </div>
      </div>
    </div>
  </div>
</header>

<div role="dialog" aria-modal="true" class="m-password-modal">
  <div class="m-password-modal__content u-color--{{ color_scheme }} u-text-center" aria-modal="true">
    <button
      type="button"
      class="m-password-modal__close u-unstyled-btn js-password-modal-close"
      aria-label="{{ 'accessibility.close' | t }}"
    >
      {%- render 'icon-close' -%}
    </button>
    <h2 class="m-password-modal__heading h3">
      {{ 'general.password_page.login_form_heading' | t }}
    </h2>

    {%- form 'storefront_password', class: 'password-form m-password-modal__form' -%}
      <div class="m-password-modal__fieldset">
        <div class="a-input grid grid--no-wrap">
          <label for="password" class="visually-hidden a-input__label">
            {{ 'general.password_page.login_form_password_placeholder' | t }}
          </label>
          <input
            type="password"
            name="password"
            id="password"
            class="a-input__field a-input__field--transparent m-password-modal__input js-password-modal-input"
            autocomplete="current-password"
            {% if form.errors %}
              aria-invalid="true"
              aria-describedby="PasswordLoginForm-password-error"
            {%- endif -%}
            placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}"
          >
          <button
            type="submit"
            name="commit"
            class="a-btn a-btn--tertiary m-password-modal__submit"
            aria-label="{{ 'general.password_page.login_form_submit' | t }}"
          >
            {{ 'general.password_page.login_form_submit' | t }}
          </button>
        </div>
      </div>
      {%- if form.errors -%}
        <div id="PasswordLoginForm-password-error" class="m-password-modal__errors" role="status">
          <p class="m-password-modal__message">
            {{ 'general.password_page.login_form_error' | t -}}
          </p>
        </div>
      {%- endif -%}
      <small class="password__footer-text rte">{{ 'general.password_page.admin_link_html' | t }}</small>
    {%- endform -%}
  </div>
  <span class="u-backdrop js-password-modal-underlay"></span>
</div>

{% schema %}
{
  "name": "t:password_header.name",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.headers.section.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:password_header.settings.color_scheme.label",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
