{%- render '_styles-section', section: section -%}
{{ 'featured-product-style.css' | asset_url | stylesheet_tag }}

<script type="application/json" id="ProductJSON-{{ product.id }}">
  {{ product.media | where: 'media_type', 'model' | json }}
</script>

<script src="{{ 'product-model-script.min.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign color_scheme = section.settings.color_scheme
  assign standard_color_scheme = settings.color_schemes['scheme-1']
  assign media_size = 'grid__col-md-6'
  assign content_size = 'grid__col-md-6'

  if section.settings.media_position == 'left'
    assign media_position = 'left'
    assign content_position = 'right'
  elsif section.settings.media_position == 'right'
    assign media_position = 'right'
    assign content_position = 'left'
  endif

  assign aspect_ratio_class = 'a-img__ratio--' | append: section.settings.image_ratio

  assign product = section.settings.product
  assign product_form_id = 'product-form-' | append: section.id

  for block in section.blocks
    if block.type == 'button'
      assign btn_url = block.settings.btn_url | default: product.url
    endif
  endfor
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif

  assign placeholder_media_classes = 'a-img__ratio--' | append: section.settings.image_ratio | append: ' a-placeholder-media'
  assign media_layout = 'stacked'
  assign enable_zoom = false
  assign hide_thumbs_mobile = true
  assign enable_autoplay_video_looping = false
  assign ratio = section.settings.image_ratio

  assign is_preorder = false

  for tag in product.tags
    if tag contains 'preorder'
      assign is_preorder = true
    endif
  endfor
-%}

<div
  class="o-featured-product js-featured-product o-section u-color--{{ color_scheme }}"
  {% if section.settings.invert_navigation_color %}
    data-invert-navigation
  {% endif %}
  {% if section.settings.section_id != blank %}
    id="{{ section.settings.section_id | handleize }}"
  {% endif %}
>
  <div class="o-featured-product__inner o-section__constrict">
    <div class="grid grid--{{ section.settings.content_vertical_position }}-v">
      <div class="grid__col-12 {{ media_size }} o-featured-product__media-position--{{ media_position }} {% if settings.enable_animation %}js-animation a-animation a-animation--fade-up{% endif %}">
        {%- assign widths = '165, 360, 535, 750, 1070, 1500' -%}
        {%- capture sizes -%}
              (min-width: 750px) calc((100vw) / 2), calc((100vw) / 2)
            {%- endcapture -%}
        {%- if section.settings.image != blank -%}
          <div class="o-featured-product__image">
            {{
              section.settings.image
              | image_url: width: 1024
              | image_tag:
                class: aspect_ratio_class,
                loading: 'lazy',
                sizes: sizes,
                widths: widths,
                fetchpriority: fetch_priority
            }}
          </div>
        {%- elsif product.featured_image != blank -%}
          <div class="o-featured-product__image">
            {%- assign widths = '165, 360, 535, 750, 1070, 1500' -%}
            {%- capture sizes -%}
              (min-width: 750px) calc((100vw) / 2), calc((100vw) / 2)
            {%- endcapture -%}

            {%- assign image = product.featured_media -%}
            {%- if product.selected_or_first_available_variant.featured_media -%}
              {%- assign image = product.selected_or_first_available_variant.featured_media -%}
            {%- endif -%}
            {%- assign image_class = aspect_ratio_class | append: ' js-featured-product-image' -%}
            {{
              image
              | image_url: width: 1024
              | image_tag: class: image_class, sizes: sizes, widths: widths, fetchpriority: 'auto', rel: 'preload'
            }}
          </div>
        {%- else -%}
          <div class="o-featured-product__image">
            {{ 'product-1' | placeholder_svg_tag: placeholder_media_classes }}
          </div>
        {%- endif -%}
      </div>
      <div class="grid__col-12 {{ content_size }} o-featured-product__content-position--{{ content_position }} {% if settings.enable_animation %}js-animation a-animation a-animation--fade-up{% endif %}">
        <div class="o-featured-product__content u-text-{{ section.settings.content_alignment }}">
          {%- liquid
            for block in section.blocks
              capture block_styles
                render '_styles-blocks', block: block
              endcapture
              case block.type
                when 'heading'
                  render 'block-heading', block: block, override_content: product.title, block_styles: block_styles, block_class: 'o-featured-product__heading', disable_animation: true
                when 'usps'
                  render 'block-usps', block: block, block_styles: block_styles, block_class: 'o-featured-product__usps', disable_animation: true
                when 'caption'
                  render 'block-caption', block: block, override_content: block.settings.title, block_styles: block_styles, block_class: 'o-featured-product__caption', base_tag: 'div', disable_animation: true
                when 'custom_liquid'
                  render 'product-block-custom-liquid', block: block, block_styles: block_styles
                when 'text'
                  render 'block-text', block: block, override_content: product.description, block_styles: block_styles, block_class: 'o-featured-product__text', disable_animation: true
                when 'button'
                  if block.settings.btn_label != blank
                    render 'block-button', block: block, block_styles: block_styles, block_class: blank, disable_animation: true
                  endif
                when 'price'
                  render 'product-block-price', product: product, block: block, block_styles: block_styles
                when 'quantity_selector'
                  render 'product-block-quantity-selector', section: section, product: product, block: block, product_form_id: product_form_id, block_styles: block_styles

                when 'variant_picker'
                  render 'product-block-variant-picker', section: section, product: product, block: block, product_form_id: product_form_id, update_url: false, update_media: false, block_styles: block_styles

                when 'buy_buttons'
                  if product != blank
                    render 'product-block-buy-buttons', section: section, product: product, block: block, product_form_id: product_form_id, block_styles: block_styles, is_preorder: is_preorder
                  else
                    assign button_label = 'products.product.sold_out' | t
                    render 'block-button', block: block, block_styles: block_styles, block_class: 'm-product-form__submit u-text-center a-btn a-btn--primary', disabled: true, override_content: button_label, disable_animation: true
                  endif
              endcase
            endfor
          -%}
        </div>
      </div>
    </div>
  </div>
</div>

