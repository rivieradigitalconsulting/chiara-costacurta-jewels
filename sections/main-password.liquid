{%- render '_styles-section', section: section -%}
{{ 'main-password-style.css' | asset_url | stylesheet_tag }}

<link rel="stylesheet" href="{{ 'social-icons-style.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'social-icons-style.css' | asset_url | stylesheet_tag }}</noscript>

{%- liquid
  assign color_scheme = section.settings.color_scheme
  assign standard_color_scheme = settings.color_schemes['scheme-1']
-%}

<div
  class="t-password o-section u-color--{{ color_scheme }}"
  {% if section.settings.section_id != blank %}
    id="{{ section.settings.section_id | handleize }}"
  {% endif %}
>
  <div class="t-password__inner o-section__constrict">
    <div class="grid grid--{{ section.settings.content_position }}-h">
      <div class="grid__col-12 grid__col-md-{{ section.settings.column_width }}">
        <div class="t-password__content u-text-{{ section.settings.content_alignment }}">
          {%- for block in section.blocks -%}
            {%- liquid
              capture block_styles
                render '_styles-blocks', block: block
              endcapture
            -%}
            {%- case block.type -%}
              {%- when 'heading' -%}
                <h1
                  class="t-password__heading {{ block.settings.heading_size }} a-spacing-content"
                  style="{{ block_styles | strip_newlines | remove: ' ' }}"
                  {{ block.shopify_attributes }}
                >
                  {{ block.settings.heading | escape }}
                </h1>
              {%- when 'paragraph' -%}
                <div
                  class="t-password__text rte {{ block.settings.text_size }} a-spacing-content"
                  style="{{ block_styles | strip_newlines | remove: ' ' }}"
                  {{ block.shopify_attributes }}
                >
                  {%- if shop.password_message != blank and block.settings.enable_password_message -%}
                    {{ shop.password_message }}
                  {%- else -%}
                    {{ block.settings.text }}
                  {%- endif -%}
                </div>
              {%- when 'newsletter' -%}
                <div
                  class="o-newsletter__form t-password__newsletter a-spacing-content"
                  style="{{ block_styles | strip_newlines | remove: ' ' }}"
                  {{ block.shopify_attributes }}
                >
                  {%- render 'newsletter-form', section: section, id: 'NewsletterSection', button_type: 'text' -%}
                </div>
              {%- when 'socials' -%}
                <div
                  class="t-password__socials a-spacing-content"
                  style="{{ block_styles | strip_newlines | remove: ' ' }}"
                  {{ block.shopify_attributes }}
                >
                  <h2
                    class="t-password__socials-heading {{ block.settings.heading_size }}"
                  >
                    {{ block.settings.heading | escape }}
                  </h2>
                  {%- render 'social-icons', alignment: section.settings.content_alignment -%}
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</div>
