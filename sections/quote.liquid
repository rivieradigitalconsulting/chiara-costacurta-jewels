{%- render '_styles-section', section: section -%}
{{ 'quote-style.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign color_scheme = section.settings.color_scheme
  assign standard_color_scheme = settings.color_schemes['scheme-1']

  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
-%}

<section
  class="o-section o-quote u-color--{{ color_scheme }}"
  {% if section.settings.invert_navigation_color %}
    data-invert-navigation
  {% endif %}
  {% if section.settings.section_id != blank %}
    id="{{ section.settings.section_id | handleize }}"
  {% endif %}
>
  {%- render 'section-bg-image', section: section -%}

  <div class="o-section__constrict o-quote__inner">
    <div class="grid grid--{{ section.settings.content_position }}-h u-text-{{ section.settings.content_alignment }}">
      <div class="o-quote__content grid__col-md-{{ section.settings.column_width }} o-quote__media-at-{{ section.settings.media_position }}">
        {%- liquid
          for block in section.blocks
            capture block_styles
              render '_styles-blocks', block: block
            endcapture
            case block.type
              when 'image'
                assign widths = '50, 100, 150, 200'
                assign sizes = '(min-width: 750px) calc((100vw) / 2), calc((100vw) / 2)'

                render 'block-image', block: block, block_styles: block_styles, block_class: 'o-quote__image', sizes: sizes, widths: widths, fetch_priority: fetch_priority, width: 300
              when 'heading'
                render 'block-heading', block: block, block_styles: block_styles, block_class: 'o-quote__heading', base_tag: 'blockquote'
              when 'paragraph'
                render 'block-text', block: block, block_styles: block_styles, block_class: 'o-quote__author'
            endcase
          endfor
        -%}
      </div>
    </div>
  </div>
</section>

