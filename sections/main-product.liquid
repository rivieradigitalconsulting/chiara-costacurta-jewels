{%- render '_styles-section', section: section -%}
{{ 'main-product-style.css' | asset_url | stylesheet_tag }}
{{ 'product-media-style.css' | asset_url | stylesheet_tag }}
{{ 'price-style.css' | asset_url | stylesheet_tag }}
{{ 'accordion-style.css' | asset_url | stylesheet_tag }}
{{ 'social-icons-style.css' | asset_url | stylesheet_tag }}
{{ 'product-usp-style.css' | asset_url | stylesheet_tag }}

<script type="application/json" id="ProductJSON-{{ product.id }}">
  {{ product.media | where: 'media_type', 'model' | json }}
</script>

<script src="{{ 'product-form-script.min.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-model-script.min.js' | asset_url }}" defer="defer"></script>

{%- if product.media.size > 1 -%}
  <script src="{{ 'product-media-script.min.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- liquid
  assign color_scheme = section.settings.color_scheme
  assign action_bar_color_scheme = section.settings.action_bar_color_scheme
  assign standard_color_scheme = settings.color_schemes['scheme-1']

  assign has_tabs = false
  assign product_form_id = 'product-form-' | append: section.id
  assign has_sticky_info = section.settings.enable_sticky_info
  assign has_sticky_add_to_cart_bar = section.settings.enable_sticky_add_to_cart_bar

  assign ratio = section.settings.media_ratio
  assign enable_autoplay_video_looping = section.settings.enable_autoplay_video_looping
  assign hide_thumbs_mobile = section.settings.hide_thumbs_mobile
  assign enable_zoom = section.settings.enable_zoom

  assign media_layout = section.settings.media_layout

  assign hasDynamicCheckout = false

  for block in section.blocks
    if block.settings.show_dynamic_checkout
      assign hasDynamicCheckout = true
    endif
  endfor

  assign is_preorder = false

  for tag in product.tags
    if tag contains 'preorder'
      assign is_preorder = true
    endif
  endfor
-%}

{%- if enable_zoom -%}
  {{ 'product-zoom-style.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'product-zoom-script.min.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- if has_sticky_add_to_cart_bar -%}
  {{ 'product-action-bar-style.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'product-action-bar-script.min.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

<section
  id="main-product-{{ section.id }}"
  class="o-product o-section js-main-product {% if has_sticky_add_to_cart_bar %}o-product--has-sticky-action-bar{% endif %} u-color--{{ color_scheme }}"
  data-section="{{ section.id }}"
  {% if section.settings.invert_navigation_color %}
    data-invert-navigation
  {% endif %}
  {% if section.settings.section_id != blank %}
    id="{{ section.settings.section_id | handleize }}"
  {% endif %}
>
  <div class="o-product__inner o-section__constrict">
    <div class="o-product__content grid grid--top-v grid--no-wrap-md">
      <div
        id="main-product-media-{{ section.id }}"
        class="o-product__media o-product__media--{{ section.settings.media_position }} grid__col-12 grid__col-md-6 grid__col-xl-7 js-product-media"
        data-type="{{ media_layout }}"
      >
        {%- case media_layout -%}
          {%- when 'stacked' -%}
            {%- render 'product-media-stacked',
              product: product,
              ratio: ratio,
              enable_autoplay_video_looping: enable_autoplay_video_looping,
              enable_zoom: enable_zoom
            -%}
          {%- when 'columns' -%}
            {%- render 'product-media-columns',
              product: product,
              ratio: ratio,
              enable_autoplay_video_looping: enable_autoplay_video_looping,
              enable_zoom: enable_zoom
            -%}
          {%- when 'slider' -%}
            {%- render 'product-media-slider',
              product: product,
              ratio: ratio,
              enable_autoplay_video_looping: enable_autoplay_video_looping,
              hide_thumbs_mobile: hide_thumbs_mobile,
              enable_zoom: enable_zoom
            -%}
        {%- endcase -%}
      </div>
      <div class="o-product__information {% if has_sticky_info %}o-product__information--sticky{% endif %} grid__col-12 grid__col-md-6 grid__col-xl-5 {% if settings.enable_animation %}js-animation a-animation a-animation--fade-up{% endif %}">
        <div class="o-product__breadcrumbs">
          {%- render 'breadcrumbs' -%}
        </div>
        {%- liquid
          for block in section.blocks
            capture block_styles
              render '_styles-blocks', block: block
            endcapture
            case block.type
              when '@app'
                render block
              when 'text'
                render 'product-block-text', block: block, block_styles: block_styles
              when 'badge'
                render 'product-badge', product: product, block: block, block_styles: block_styles
              when 'title'
                render 'product-block-title', product: product, block: block, block_styles: block_styles
              when 'price'
                render 'product-block-price', product: product, block: block, block_styles: block_styles
              when 'description'
                render 'product-block-description', product: product, block: block, block_styles: block_styles
              when 'custom_liquid'
                render 'product-block-custom-liquid', block: block, block_styles: block_styles
              when 'tab'
                assign has_tabs = true
                render 'product-block-tab', block: block, block_styles: block_styles, block_class: 'o-product__accordion', disable_animation: true
              when 'usp'
                render 'product-block-usp', product: product, block: block, block_styles: block_styles
              when 'pickup_availability'
                render 'product-block-pickup-availibilty', product: product, section: section, block: block, block_styles: block_styles
              when 'share'
                render 'product-block-share', section: section, product: product, block: block, block_styles: block_styles
              when 'quantity_selector'
                render 'product-block-quantity-selector', section: section, product: product, block: block, product_form_id: product_form_id, block_styles: block_styles
              when 'variant_picker'
                render 'product-block-variant-picker', section: section, product: product, block: block, product_form_id: product_form_id, update_url: true, block_styles: block_styles
              when 'buy_buttons'
                render 'product-block-buy-buttons', section: section, product: product, block: block, product_form_id: product_form_id, block_styles: block_styles, is_preorder: is_preorder
              when 'complementary'
                render 'product-block-complementary', section: section, product: product, block: block, block_styles: block_styles
              when 'recommended'
                render 'product-block-recommended', section: section, product: product, block: block, block_styles: block_styles
              when 'button'
                render 'block-button', section: section, block: block, block_styles: block_styles
            endcase
          endfor
        -%}
      </div>
    </div>
  </div>
  {%- if has_sticky_add_to_cart_bar -%}
    <div
      class="o-product__actions-bar m-action-bar js-action-bar u-color--{{ action_bar_color_scheme }}"
      id="product-action-bar-{{ section.id }}"
    >
      <div class="m-action-bar__inner o-section__page-width grid grid--center-v">
        <div class="m-action-bar__info">
          {%- if product.featured_image != blank -%}
            <div class="m-action-bar__media">
              {{
                product.featured_image
                | image_url: width: 140
                | image_tag: class: 'm-action-bar__image', loading: 'lazy'
              }}
            </div>
          {%- endif -%}
          <h3 class="m-action-bar__title body-fs-lg">
            {{ product.title | escape }}
          </h3>
        </div>
        <div class="m-action-bar__actions">
          <button
            aria-label="
              {% if product.selected_or_first_available_variant.available %}
                {{ 'products.product.add_to_cart' | t }}
              {% else %}
                {{ 'products.product.sold_out' | t }}
              {% endif %}
            "
            class="m-action-bar__button a-btn {% if is_preorder %}is-preorder{% endif %} {% if hasDynamicCheckout %}a-btn--secondary{% else %}a-btn--primary{% endif %} js-action-bar-button"
          >
            <span class="m-action-bar__submit-text">
              {%- if product.selected_or_first_available_variant.available -%}
                {{ 'products.product.add_to_cart' | t }}
              {%- else -%}
                {{ 'products.product.sold_out' | t }}
              {%- endif -%}
            </span>
            <span class="m-action-bar__loader hide">
              {%- render 'icon-loader', loader_classes: 'a-loader--light' -%}
            </span>
          </button>
        </div>
      </div>
    </div>
  {%- endif -%}
</section>

{%- if has_tabs -%}
  <script src="{{ 'accordion-script.min.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- render 'product-seo-schema', product: product -%}

