{%- render '_styles-section', section: section -%}
{{ 'rich-text-style.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign color_scheme = section.settings.color_scheme
  assign standard_color_scheme = settings.color_schemes['scheme-1']

  assign has_custom_title_position = false

  unless section.settings.title_position == 'inline'
    assign has_custom_title_position = true
    assign title_block = section.blocks | where: 'type', 'heading' | first
  endunless
-%}

{%- capture custom_title -%}
  {%- liquid
    if has_custom_title_position
      capture block_styles
        render '_styles-blocks', block: title_block
      endcapture
      render 'block-heading', block: title_block, block_styles: block_styles, block_class: 'o-rich-text__heading'
    endif
  -%}
{%- endcapture -%}

{%- capture blocks -%}
  {%- liquid
    for block in section.blocks
      capture block_styles
        render '_styles-blocks', block: block
      endcapture
      case block.type
        when 'caption'
          render 'block-caption', block: block, block_styles: block_styles, block_class: 'o-rich-text__caption', override_content: block.settings.title, base_tag: 'div'
        when 'heading'
          unless has_custom_title_position
            render 'block-heading', block: block, block_styles: block_styles, block_class: 'o-rich-text__heading'
          endunless
        when 'paragraph'
          render  'block-text', block: block, block_styles: block_styles, block_class: 'o-rich-text__paragraph'
        when 'button'
          if block.settings.btn_label != blank
            render 'block-button', block: block, block_styles: block_styles, block_class: 'o-rich-text__button'
          endif
      endcase
    endfor
  -%}
{%- endcapture -%}

<section
  class="o-section o-rich-text u-color--{{ color_scheme }}"
  {% if section.settings.invert_navigation_color %}
    data-invert-navigation
  {% endif %}
  {% if section.settings.section_id != blank %}
    id="{{ section.settings.section_id | handleize }}"
  {% endif %}
>
  {%- render 'section-bg-image', section: section -%}

  <div class="o-section__constrict">
    <div class="grid grid--{{ section.settings.content_position }}-h">
      <div class="grid__col-12 grid__col-md-{{ section.settings.column_width }}">
        <div class="u-text-{{ section.settings.content_alignment }} {% if has_custom_title_position %}o-rich-text__columns{% endif %}">
          {%- if has_custom_title_position -%}
            <div class="o-rich-text__column o-rich-text__column--{{ section.settings.title_position }}">
              {%- if title_block != blank -%}
                {{ custom_title }}
              {%- endif -%}
            </div>
            <div class="o-rich-text__column">
              {{ blocks }}
            </div>
          {%- else -%}
            {{ blocks }}
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

