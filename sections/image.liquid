{%- render '_styles-section', section: section -%}
{{ 'image-style.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign color_scheme = section.settings.color_scheme
  assign standard_color_scheme = settings.color_schemes['scheme-1']

  assign media_width = section.settings.media_contain_width
  assign column_width = section.settings.column_width
  if column_width == 12 and media_width == false
    assign full_width = true
  endif

  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
-%}

<div
  class="o-image o-section u-color--{{ color_scheme }}"
  {% if section.settings.invert_navigation_color %}
    data-invert-navigation
  {% endif %}
  {% if section.settings.section_id != blank %}
    id="{{ section.settings.section_id | handleize }}"
  {% endif %}
>
  <div class="o-image__inner {% if media_width %}o-section__constrict{% endif %} {% if full_width %}o-section--fw{% endif %}">
    <div class="grid grid--{{ section.settings.content_position }}-h">
      <div class="grid__col-12 grid__col-md-{{ section.settings.column_width }}">
        <div class="o-image__content u-text-{{ section.settings.content_alignment }}">
          {%- liquid
            for block in section.blocks
              capture block_styles
                render '_styles-blocks', block: block
              endcapture
              case block.type
                when 'caption'
                  render 'block-caption', block: block, block_styles: block_styles, block_class: 'o-image__caption', override_content: block.settings.title, base_tag: 'div'
                when 'heading'
                  render 'block-heading', block: block, block_styles: block_styles, block_class: 'o-image__heading'
                when 'paragraph'
                  render 'block-text', block: block, block_styles: block_styles, block_class: 'o-image__text'
                when 'button'
                  if block.settings.btn_label != blank
                    render 'block-button', block: block, block_styles: block_styles, block_class: 'o-image__button'
                  endif
                when 'image'
                  assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
                  assign sizes = '100vw'
                  assign height = block.settings.image.width | divided_by: block.settings.image.image_ratio | round
                  render 'block-image', block: block, block_styles: block_styles, block_class: 'o-image__image', sizes: sizes, widths: widths, fetch_priority: fetch_priority, width: 2000, height: height
              endcase
            endfor
          -%}
        </div>
      </div>
    </div>
  </div>
</div>

