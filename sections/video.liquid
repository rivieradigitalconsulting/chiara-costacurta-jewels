{%- render '_styles-section', section: section -%}
<script src="{{ 'video-script.min.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign color_scheme = section.settings.color_scheme
  assign standard_color_scheme = settings.color_schemes['scheme-1']

  assign media_width = section.settings.media_contain_width
  assign column_width = section.settings.column_width
  if column_width == 12 and media_width == false
    assign full_width = true
  endif
-%}

<div
  class="o-video o-section u-color--{{ color_scheme }}"
  {% if section.settings.invert_navigation_color %}
    data-invert-navigation
  {% endif %}
  {% if section.settings.section_id != blank %}
    id="{{ section.settings.section_id | handleize }}"
  {% endif %}
>
  <div class="o-video__inner {% if media_width %}o-section__constrict{% endif %} {% if full_width %}o-section--fw{% endif %}">
    <div class="grid grid--{{ section.settings.content_position }}-h">
      <div class="grid__col-12 grid__col-md-{{ section.settings.column_width }}">
        <div class="o-video__content u-text-{{ section.settings.content_alignment }}">
          {%- liquid
            for block in section.blocks
              capture block_styles
                render '_styles-blocks', block: block
              endcapture
              case block.type
                when 'caption'
                  render 'block-caption', block: block, block_styles: block_styles, block_class: 'o-video__caption', override_content: block.settings.title, base_tag: 'div'
                when 'heading'
                  render 'block-heading', block: block, block_styles: block_styles, block_class: 'o-video__heading'
                when 'paragraph'
                  render  'block-text', block: block, block_styles: block_styles, block_class: 'o-video__text'
                when 'button'
                  if block.settings.btn_label != blank
                    render 'block-button', block: block, block_styles: block_styles, block_class: 'o-video__button'
                  endif
                when 'video'
                  assign video_autoplay = block.settings.video_autoplay
                  assign video_controls = true
                  if block.settings.video_autoplay
                    assign video_autoplay = true
                    assign video_controls = false
                  endif
                  render 'block-video', block: block, block_styles: block_styles, video_autoplay: video_autoplay, video_controls: video_controls, block_class: 'o-video__video'
                endcase
            endfor
          -%}
        </div>
      </div>
    </div>
  </div>
</div>

