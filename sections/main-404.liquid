{%- render '_styles-section', section: section -%}
{{ '404-style.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign color_scheme = section.settings.color_scheme
  assign standard_color_scheme = settings.color_schemes['scheme-1']

  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
-%}

<div
  class="t-404 o-section u-color--{{ color_scheme }}"
  {% if section.settings.invert_navigation_color %}
    data-invert-navigation
  {% endif %}
  {% if section.settings.section_id != blank %}
    id="{{ section.settings.section_id | handleize }}"
  {% endif %}
>
  <div class="t-404__inner o-section__constrict">
    <div class="grid grid--{{ section.settings.content_position }}-h">
      <div class="grid__col-12 grid__col-md-{{ section.settings.column_width }}">
        <div class="t-404__content u-text-{{ section.settings.content_alignment }}">
          {%- for block in section.blocks -%}
            {%- liquid
              capture block_styles
                render '_styles-blocks', block: block
              endcapture
            -%}
            {%- case block.type -%}
              {%- when 'heading' -%}
                {%- liquid
                  assign tag = 'h2'
                  if block.settings.convert_to_h1
                    assign tag = 'h1'
                  endif
                -%}
                <{{ tag }}
                  class="t-404__heading {{ block.settings.heading_size }} a-spacing-content {% if settings.enable_animation %}js-animation a-animation a-animation--fade-up{% endif %}"
                  style="{{ block_styles | strip_newlines | remove: ' ' }}"
                  {{ block.shopify_attributes }}
                >
                  {{ block.settings.heading | escape }}
                </{{ tag }}>
              {%- when 'paragraph' -%}
                <div
                  class="t-404__text rte {{ block.settings.text_size }} a-spacing-content {% if settings.enable_animation %}js-animation a-animation a-animation--fade-up{% endif %}"
                  style="{{ block_styles | strip_newlines | remove: ' ' }}"
                  {{ block.shopify_attributes }}
                >
                  {{ block.settings.text }}
                </div>
              {%- when 'button' -%}
                <a
                  class="{% if block.settings.btn_style == "line" %} a-link {% else %} a-btn a-btn--{{ block.settings.btn_style }}{% endif %} {% if block.settings.btn_icon %}a-btn--has-icon{% endif %} a-spacing-content {% if settings.enable_animation %}js-animation a-animation a-animation--fade-up{% endif %}"
                  href="{{ block.settings.btn_url }}"
                  style="{{ block_styles | strip_newlines | remove: ' ' }}"
                  {{ block.shopify_attributes }}
                >
                  {{- block.settings.btn_label -}}
                  {% if block.settings.btn_icon %}
                    {%- render 'icon-arrow-right' -%}
                  {%- endif %}
                </a>
              {%- when 'image' -%}
                {% if block.settings.image %}
                  {%- assign widths = '165, 360, 535, 750, 1070, 1500' -%}
                  {%- assign sizes = '100vw' -%}
                  <div
                    class="grid grid--center-h a-spacing-content {% if settings.enable_animation %}js-animation a-animation a-animation--fade-up{% endif %}"
                    style="{{ block_styles | strip_newlines | remove: ' ' }}"
                    {{ block.shopify_attributes }}
                  >
                    <div class="t-404__image grid__col-12 grid__col-md-{{ block.settings.image_width }}">
                      {{
                        block.settings.image
                        | image_url: width: 1024
                        | image_tag: sizes: sizes, widths: widths, fetchpriority: fetch_priority, loading: 'lazy'
                      }}
                    </div>
                  </div>
                {%- else -%}
                  <div
                    class="grid grid--center-h a-spacing-content {% if settings.enable_animation %}js-animation a-animation a-animation--fade-up{% endif %}"
                    style="{{ block_styles | strip_newlines | remove: ' ' }}"
                    {{ block.shopify_attributes }}
                  >
                    <div class="t-404__image grid__col-12 grid__col-md-{{ block.settings.image_width }}">
                      {{ 'image' | placeholder_svg_tag: 'a-placeholder-media' }}
                    </div>
                  </div>
                {% endif %}
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</div>

