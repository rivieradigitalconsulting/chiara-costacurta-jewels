{%- render '_styles-section', section: section -%}
{{ 'banner-style.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign color_scheme = section.settings.color_scheme

  assign video_autoplay = true
  assign video_controls = false

  assign fetch_priority = 'auto'
  assign first_section_on_page = false
  if section.index == 1
    assign first_section_on_page = true

    assign fetch_priority = 'high'
  endif
  assign section_width = section.settings.section_width
-%}

<div
  class="o-banner o-banner__{{ section_width }} o-banner__size--{{ section.settings.section_height }} {% if first_section_on_page %}o-banner__first-section-on-page{% endif %} o-section u-color--{{ color_scheme }}"
  {% if section.settings.invert_navigation_color %}
    data-invert-navigation
  {% endif %}
  {% if section.settings.section_id != blank %}
    id="{{ section.settings.section_id | handleize }}"
  {% endif %}
>
  {%- if section_width == 'constrict' -%}
    <div class="o-section__{{ section_width }}">
  {%- endif -%}
  <div class="o-banner__inner">
    {%- unless section_width == 'constrict' -%}
      <div class="o-section__constrict">
    {%- endunless -%}
    <div class="o-banner__content-wrapper grid grid--{{ section.settings.content_position }}-h grid--{{ section.settings.vertical_content_position }}-v">
      <div class="grid__col-12 grid__col-md-{{ section.settings.column_width }}">
        <div class="o-banner__content u-text-{{ section.settings.content_alignment }}">
          {%- liquid
            for block in section.blocks
              capture block_styles
                render '_styles-blocks', block: block
              endcapture
              case block.type
                when 'caption'
                  render 'block-caption', block: block, block_styles: block_styles, block_class: 'o-banner__caption'
                when 'heading'
                  render 'block-heading', block: block, block_styles: block_styles, block_class: 'o-banner__heading'
                when 'paragraph'
                  render  'block-text', block: block, block_styles: block_styles, block_class: 'o-banner__text'
                when 'button'
                  if block.settings.btn_label != blank
                    render 'block-button', block: block, block_styles: block_styles, block_class: 'o-banner__button'
                  endif
              endcase
            endfor
          -%}
        </div>
      </div>
    </div>
    <div class="o-banner__background-media">
      {% if section.settings.video %}
        <div class="o-banner__video a-video">
          {{
            section.settings.video
            | video_tag: controls: video_controls, autoplay: video_autoplay, loop: video_autoplay
          }}
        </div>
      {% else %}
        {% if section.settings.image %}
          {% liquid
            assign sizes = '100vw'
            assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
          %}
          <div class="o-banner__image">
            {%- if section.index == 1 -%}
              {{
                section.settings.image
                | image_url: width: 1600
                | image_tag: sizes: sizes, widths: widths, fetchpriority: fetch_priority
              }}
            {%- else -%}
              {{
                section.settings.image
                | image_url: width: 1600
                | image_tag: sizes: sizes, widths: widths, fetchpriority: fetch_priority, loading: 'lazy'
              }}
            {%- endif -%}
          </div>
        {%- else -%}
          <div class="o-banner__image">
            {{ 'lifestyle-1' | placeholder_svg_tag: 'a-placeholder-media' }}
          </div>
        {% endif %}
      {% endif %}

      {% if section.settings.overlay_color and section.settings.overlay_opacity %}
        <div
          class="o-banner__overlay"
          style="background-color: {{ section.settings.overlay_color }}; opacity: {{ section.settings.overlay_opacity | round: 2 | divided_by: 100.00 }};"
        ></div>
      {% endif %}
    </div>
    {%- unless section_width == 'constrict' -%}
      </div>
    {%- endunless -%}
  </div>
  {%- if section_width == 'constrict' -%}
    </div>
  {%- endif -%}
</div>

