        },
        {
          "type": "image_picker",
          "id": "image_2",
          "label": "t:slideshow.blocks.slide.slide.settings.image_2.label"
        },
        {
          "type": "image_picker",
          "id": "mobile_image_1",
          "label": "t:slideshow.blocks.slide.slide.settings.mobile_image_1.label"
        },
        {
          "type": "image_picker",
          "id": "mobile_image_2",
