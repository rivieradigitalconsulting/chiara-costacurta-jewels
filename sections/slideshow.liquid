          "options": [
            {
              "value": "primary",
              "label": "t:slideshow.blocks.slide.slide.settings.btn_style.options.primary.label"
            },
            {
              "value": "secondary",
              "label": "t:slideshow.blocks.slide.slide.settings.btn_style.options.secondary.label"
            },
