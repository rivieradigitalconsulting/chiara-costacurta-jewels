        },
        {
          "type": "select",
          "id": "content_position",
          "label": "t:slideshow.blocks.slide.slide.settings.content_position.label",
          "options": [
            {
              "value": "left",
              "label": "t:slideshow.blocks.slide.slide.settings.content_position.options.left.label"
            },
            {
              "value": "center",
              "label": "t:slideshow.blocks.slide.slide.settings.content_position.options.center.label"
            },
            {
              "value": "right",
              "label": "t:slideshow.blocks.slide.slide.settings.content_position.options.right.label"
            }
          ],
          "default": "center"
        },
        {
          "type": "text_alignment",
          "id": "content_alignment",
          "label": "t:slideshow.blocks.slide.slide.settings.content_alignment.label",
          "default": "center"
        },
        {
          "type": "header",
          "content": "t:slideshow.blocks.slide.slide.settings.header.media.content"
        },
        {
          "type": "color",
          "id": "overlay_color",
          "label": "t:slideshow.blocks.slide.slide.settings.overlay_color.label",
          "default": "#000"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "min": 0,
