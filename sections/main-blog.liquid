{%- render '_styles-section', section: section -%}
{{ 'main-blog-style.css' | asset_url | stylesheet_tag }}
{{ 'article-card-style.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign articles_per_page = section.settings.articles_per_page
  assign show_filters = section.settings.show_filters

  if show_filters
    assign filters = section.settings.order_filters | split: ','
  endif
-%}

<div
  class="o-blog o-section"
  {% if section.settings.invert_navigation_color %}
    data-invert-navigation
  {% endif %}
  {% if section.settings.section_id != blank %}
    id="{{ section.settings.section_id | handleize }}"
  {% endif %}
>
  <div class="o-blog__inner o-section__constrict">
    <div class="o-blog__header">
      <div class="o-blog__content u-text-{{ section.settings.content_alignment }}">
        <div class="grid grid--{{ section.settings.content_position }}-h">
          <div class="grid__col-12 grid__col-lg-{{ section.settings.content_width }}">
            {%- if section.settings.heading != blank -%}
              <h1
                class="o-blog__heading {{ section.settings.heading_size }} {% if settings.enable_animation %}js-animation a-animation a-animation--fade-up{% endif %}"
                {{ block.shopify_attributes }}
              >
                {{ section.settings.heading | escape }}
              </h1>
            {%- endif -%}
            {%- if section.settings.text != blank -%}
              <div
                class="o-blog__text rte {{ section.settings.text_size }} {% if settings.enable_animation %}js-animation a-animation a-animation--fade-up{% endif %}"
                {{ block.shopify_attributes }}
              >
                {{ section.settings.text }}
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
    {%- if show_filters -%}
      <div class="o-blog__filters">
        <a class="o-blog__filter {% if current_tags == blank %}active{% endif %}" href="{{ blog.url }}">
          {{- 'blogs.all' | t -}}
        </a>

        {%- if filters != blank -%}
          {%- for filter in filters -%}
            {%- liquid
              assign current_tags = current_tags | handleize
              assign current_tag = filter | handleize
            -%}
            <a
              class="o-blog__filter {% if current_tag == current_tags %}active{% endif %} {% if settings.enable_animation %}js-animation a-animation a-animation--fade-up{% endif %}"
              href="{{ blog.url }}/tagged/{{ filter | handle }}"
            >
              {{ filter | capitalize }}
            </a>
          {%- endfor -%}
        {%- else -%}
          {%- for tag in blog.all_tags -%}
            {%- liquid
              assign current_tags = current_tags | handleize
              assign current_tag = tag | handleize
            -%}
            <a
              class="o-blog__filter {% if current_tag == current_tags %}active{% endif %} {% if settings.enable_animation %}js-animation a-animation a-animation--fade-up{% endif %}"
              href="{{ blog.url }}/tagged/{{ tag | handle }}"
            >
              {{- tag -}}
            </a>
          {%- endfor -%}
        {%- endif -%}
      </div>
    {%- endif -%}
    {%- paginate blog.articles by articles_per_page -%}
      <div class="o-blog__article-wrapper">
        {%- for article in blog.articles -%}
          {%- liquid
            assign mod = forloop.index | modulo: 2
            assign class_article = 'grid--left-h'
            assign class_col = 'grid__col-md-6'
            assign image_ratio = '4x5'

            if mod == 0
              assign class_article = 'grid--right-h'
              assign class_col = 'grid__col-md-8'
              assign image_ratio = '16x9'
            endif
          -%}
          <div class="o-featured-blog__article grid {{ class_article }}">
            <div class="grid__col-12 {{ class_col }}">
              {%- render 'article-card',
                article: article,
                show_image: section.settings.show_image,
                show_date: section.settings.show_date,
                show_author: section.settings.show_author,
                show_title: section.settings.show_title,
                show_excerpt: section.settings.show_excerpt,
                show_link: section.settings.show_link,
                article_card_image_ratio: image_ratio
              -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}
        {% render 'pagination', paginate: paginate, anchor: '' %}
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "t:main_blog.name",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.headers.section.content"
    },
    {
      "type": "text",
      "id": "section_id",
      "label": "t:sections.all.section_id.label",
      "info": "t:sections.all.section_id.info"
    },
    {
      "type": "header",
      "content": "t:sections.all.headers.spacing.content"
    },
    {
      "type": "range",
      "id": "section_padding_top_desktop",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 80,
      "unit": "px",
      "label": "t:sections.all.padding.top.desktop.label"
    },
    {
      "type": "range",
      "id": "section_padding_bottom_desktop",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 80,
      "unit": "px",
      "label": "t:sections.all.padding.bottom.desktop.label"
    },
    {
      "type": "range",
      "id": "section_padding_top_mobile",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 40,
      "unit": "px",
      "label": "t:sections.all.padding.top.mobile.label",
      "info": "t:sections.all.padding.top.mobile.info"
    },
    {
      "type": "range",
      "id": "section_padding_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 40,
      "unit": "px",
      "label": "t:sections.all.padding.bottom.mobile.label",
      "info": "t:sections.all.padding.bottom.mobile.info"
    },
    {
      "type": "header",
      "content": "t:sections.all.headers.color.content"
    },
    {
      "type": "checkbox",
      "id": "invert_navigation_color",
      "label": "t:sections.all.invert_navigation_color.label",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.all.headers.card.article.content"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "t:main_blog.settings.show_image.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "t:main_blog.settings.show_date.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "t:main_blog.settings.show_author.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "t:main_blog.settings.show_title.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "t:main_blog.settings.show_excerpt.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_link",
      "label": "t:main_blog.settings.show_link.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.all.headers.filters.content"
    },
    {
      "type": "checkbox",
      "id": "show_filters",
      "label": "t:main_blog.settings.show_filters.label",
      "default": true
    },
    {
      "type": "text",
      "id": "order_filters",
      "label": "t:main_blog.settings.order_filters.label",
      "info": "t:main_blog.settings.order_filters.info"
    },
    {
      "type": "header",
      "content": "t:sections.all.headers.grid.content"
    },
    {
      "type": "range",
      "id": "row_gap_desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 100,
      "unit": "px",
      "label": "t:sections.all.grid.row_gap.desktop.label"
    },
    {
      "type": "range",
      "id": "row_gap_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 50,
      "unit": "px",
      "label": "t:sections.all.grid.row_gap.mobile.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.headers.layout.content"
    },
    {
      "type": "range",
      "id": "articles_per_page",
      "min": 3,
      "max": 24,
      "step": 3,
      "label": "t:main_blog.settings.articles_per_page.label",
      "default": 12
    },
    {
      "type": "range",
      "id": "content_width",
      "min": 4,
      "max": 12,
      "step": 1,
      "label": "t:main_blog.settings.content_width.label",
      "info": "t:main_blog.settings.content_width.info",
      "default": 10
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "t:main_blog.settings.content_position.label",
      "options": [
        {
          "value": "left",
          "label": "t:main_blog.settings.content_position.options.left.label"
        },
        {
          "value": "center",
          "label": "t:main_blog.settings.content_position.options.center.label"
        },
        {
          "value": "right",
          "label": "t:main_blog.settings.content_position.options.right.label"
        }
      ],
      "default": "left"
    },
    {
      "type": "text_alignment",
      "id": "content_alignment",
      "label": "t:main_blog.settings.content_alignment.label",
      "default": "left"
    },
    {
      "type": "header",
      "content": "t:sections.all.headers.content.content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:main_blog.settings.heading.label",
      "default": "t:main_blog.settings.heading.default"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:main_blog.settings.heading_size.label",
      "options": [
        {
          "value": "h3",
          "label": "t:main_blog.settings.heading_size.options.h_3.label"
        },
        {
          "value": "h2",
          "label": "t:main_blog.settings.heading_size.options.h_2.label"
        },
        {
          "value": "h1",
          "label": "t:main_blog.settings.heading_size.options.h_1.label"
        }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:main_blog.settings.text.label",
      "default": "t:main_blog.settings.text.default"
    },
    {
      "type": "select",
      "id": "text_size",
      "label": "t:main_blog.settings.text_size.label",
      "options": [
        {
          "value": "body-fs-sm",
          "label": "t:main_blog.settings.text_size.options.body_fs_sm.label"
        },
        {
          "value": "body-fs-md",
          "label": "t:main_blog.settings.text_size.options.body_fs_md.label"
        },
        {
          "value": "body-fs-lg",
          "label": "t:main_blog.settings.text_size.options.body_fs_lg.label"
        }
      ],
      "default": "body-fs-md"
    }
  ]
}
{% endschema %}
