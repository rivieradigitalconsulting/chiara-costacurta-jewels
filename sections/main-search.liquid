{%- render '_styles-section', section: section -%}
{%- liquid
  assign color_scheme = section.settings.color_scheme
  assign filter_color_scheme = section.settings.filter_drawer_color_scheme
  assign standard_color_scheme = settings.color_schemes['scheme-1']

  assign enable_filtering = section.settings.enable_filtering
  assign enable_sorting = section.settings.enable_sorting
  assign enable_product_count = section.settings.enable_product_count
  assign quick_add = settings.product_card_enable_quick_add
-%}

{{ 'main-search-style.css' | asset_url | stylesheet_tag }}
{{ 'product-card-style.css' | asset_url | stylesheet_tag }}
{{ 'content-card-style.css' | asset_url | stylesheet_tag }}
{{ 'price-style.css' | asset_url | stylesheet_tag }}

<script src="{{ 'filter-script.min.js' | asset_url }}" defer="defer"></script>

{%- if quick_add -%}
  {{ 'product-quick-add-style.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'product-form-script.min.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

<div
  class="o-main-search {% if enable_filtering %}o-main-search--has-filters{% endif %} o-section u-color--{{ color_scheme }}"
  {% if section.settings.invert_navigation_color %}
    data-invert-navigation
  {% endif %}
  {% if section.settings.section_id != blank %}
    id="{{ section.settings.section_id | handleize }}"
  {% endif %}
>
  <div class="o-main-search__inner o-section__constrict">
    <div class="grid grid--center-h">
      <div class="o-main-search__top-wrapper grid__col-12">
        <div class="o-main-search__content grid grid--{{ section.settings.content_position }}-h u-text-{{ section.settings.content_alignment }}">
          <div class="grid__col-12 grid__col-lg-{{ section.settings.content_width }}">
            {%- liquid
              for block in section.blocks
                capture block_styles
                  render '_styles-blocks', block: block
                endcapture
                case block.type
                  when 'heading'
                    assign heading_text = block.settings.heading
                    if search.performed
                      assign heading_text = block.settings.heading_searched
                    endif
                    render 'block-heading', block: block, block_styles: block_styles, block_class: 'o-main-search__heading', base_tag: 'h1', override_content: heading_text
                  when 'paragraph'
                    render  'block-text', block: block, block_styles: block_styles, block_class: 'o-main-search__paragraph'
                  when 'search_form'
                    render  'block-search-form', block: block, block_styles: block_styles, block_class: 'o-main-search__search-form', search: search
                  when 'button'
                    if block.settings.btn_label != blank
                      render 'block-button', block: block, block_styles: block_styles, block_class: 'o-main-search__button'
                    endif
                endcase
              endfor
            -%}
          </div>
        </div>
      </div>
      {%- if search.performed -%}
        {%- if search.results_count == 0 and search.filters == empty -%}
          <div class="o-main-search__empty rte grid__col-12 grid__col-md-10 u-text-{{ section.settings.content_alignment }}">
            <p role="status">{{ 'templates.search.no_results' | t: terms: search.terms }}</p>
          </div>
        {%- endif -%}
        {%- if search.results_count > 0 -%}
          <div class="o-main-search__wrapper grid__col-12">
            <div class="o-main-search__filter">
              {%- liquid
                if enable_filtering
                  render 'filter', results: search, enable_filtering: enable_filtering, enable_sorting: enable_sorting, enable_product_count: enable_product_count, filter_color_scheme: filter_color_scheme
                endif
              -%}
            </div>
            <div
              class="o-main-search__products-container"
            >
              {%- paginate search.results by section.settings.products_per_page -%}
                <div class="js-product-grid-container grid__col-12">
                  <div
                    class="o-main-search__products o-main-search__products js-product-grid-products item-grid"
                    id="product-grid"
                    data-id="{{ section.id }}"
                  >
                    {%- liquid
                      for item in search.results
                        case item.object_type
                          when 'product'
                            assign placeholder_media_index = forloop.index0 | modulo: 6 | plus: 1
                            assign placeholder_media = 'product-' | append: placeholder_media_index
                            render 'product-card', card_product: item, section_id: section.id, placeholder_media: placeholder_media
                          when 'article'
                            render 'content-card', content_item: item
                          when 'page'
                            render 'content-card', content_item: item
                        endcase
                      endfor
                    -%}
                  </div>

                  {%- liquid
                    if paginate.pages > 1
                      render 'pagination', paginate: paginate, anchor: ''
                    endif
                  -%}
                </div>
              {%- endpaginate -%}
            </div>
          </div>
        {% endif %}
      {% endif %}
    </div>
  </div>
</div>

