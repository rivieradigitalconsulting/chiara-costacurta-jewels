{%- render '_styles-section', section: section -%}
{{ 'collection-list-style.css' | asset_url | stylesheet_tag }}
{{ 'card-collection-style.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign color_scheme = section.settings.color_scheme
  assign color_scheme_card = section.settings.color_scheme_card
  assign standard_color_scheme = settings.color_schemes['scheme-1']

  assign collection_list_size = 0
  assign collection_list = section.settings.collection_list

  if collection_list != blank
    for collection in collection_list
      assign collection_list_size = collection_list_size | plus: 1
    endfor
  else
    for block in section.blocks
      assign collection_list_size = collection_list_size | plus: 1
    endfor
  endif

  assign columns_mobile = section.settings.columns_mobile | plus: 0
  assign columns_desktop = section.settings.columns_desktop | plus: 0
  assign column_gap_mobile = section.settings.column_gap_mobile | plus: 0
  assign column_gap_desktop = section.settings.column_gap_desktop | plus: 0

  assign display_mode = section.settings.display_mode
  assign content_card_position = section.settings.content_card_position

  assign is_slider = false

  if display_mode == 'slider' and collection_list_size > 1
    assign is_slider = true
  else
    assign is_slider = false
    assign display_mode = 'grid'
  endif

  assign padded_content = false

  if section.settings.section_width == 'page-width' and content_card_position == 'below-card'
    assign padded_content = true
  endif
-%}

{%- capture slider_options -%}
  {
    "direction": "horizontal",
    "slidesPerView": {{ columns_mobile }},
    "spaceBetween": {{ column_gap_mobile }},
    "speed": 600,
    "loop": false,
    "autoHeight": true,
    "navigation": {
        "nextEl": ".swiper-button-next",
        "prevEl": ".swiper-button-prev"
    },
    "breakpoints": {
      "768": {
        "slidesPerView": {{ columns_desktop }},
        "spaceBetween": {{ column_gap_desktop }}
      }
    }
  }
{%- endcapture -%}

<div
  class="o-collection-list o-section u-color--{{ color_scheme }}"
  {% if section.settings.invert_navigation_color %}
    data-invert-navigation
  {% endif %}
  {% if section.settings.section_id != blank %}
    id="{{ section.settings.section_id | handleize }}"
  {% endif %}
>
  <div class="o-collection-list__inner">
    {%- if section.settings.heading != blank or section.settings.text != blank -%}
      <div class="o-collection-list__content o-section__{{ section.settings.section_width }} u-text-{{ section.settings.content_alignment }}">
        <div class="grid grid--{{ section.settings.content_position }}-h">
          <div class="grid__col-12 grid__col-lg-{{ section.settings.content_width }}">
            {%- if section.settings.heading != blank -%}
              <h2
                class="o-collection-list__heading {{ section.settings.heading_size }} {% if settings.enable_animation %}js-animation a-animation a-animation--fade-up{% endif %}"
                {{ block.shopify_attributes }}
              >
                {{ section.settings.heading | escape }}
              </h2>
            {%- endif -%}
            {%- if section.settings.text != blank -%}
              <div
                class="o-collection-list__text rte {{ section.settings.text_size }} {% if settings.enable_animation %}js-animation a-animation a-animation--fade-up{% endif %}"
                {{ block.shopify_attributes }}
              >
                {{ section.settings.text }}
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endif -%}
    <div class="{% if section.settings.section_width == 'constrict' %}o-section__constrict{% endif %}">
      <div
        class="o-collection-list__slider-wrapper o-collection-list__slider-wrapper--{{ display_mode }} js-collection-list {% if is_slider %}swiper m-swiper{% endif %}"
      >
        <div class="{%- if is_slider %}item-flex-grid swiper-wrapper{% else %}item-grid{% endif %}">
          {%- if collection_list != blank -%}
            {%- for collection in collection_list -%}
              {%- liquid
                assign placeholder_media_index = forloop.index0 | modulo: 6 | plus: 1
                assign placeholder_media = 'collection-' | append: placeholder_media_index
              -%}
              <div class="swiper-slide">
                {%- render 'card-collection',
                  card_collection: collection,
                  card_vertical_text_alignment: section.settings.vertical_text_alignment,
                  settings_card_scheme: color_scheme_card,
                  card_image_ratio: section.settings.image_ratio,
                  show_description: section.settings.show_description,
                  placeholder_media: placeholder_media,
                  content_position: content_card_position,
                  card_text_alignment: section.settings.card_text_alignment,
                  padded_content: padded_content
                -%}
              </div>
            {%- endfor -%}
          {%- elsif section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
              {%- liquid
                assign placeholder_media_index = forloop.index0 | modulo: 6 | plus: 1
                assign placeholder_media = 'collection-' | append: placeholder_media_index
              -%}
              <div class="swiper-slide" {{ block.shopify_attributes }}>
                {%- render 'card-collection',
                  block: block,
                  card_collection: block.settings.collection,
                  card_vertical_text_alignment: section.settings.vertical_text_alignment,
                  settings_card_scheme: color_scheme_card,
                  card_image_ratio: section.settings.image_ratio,
                  show_description: section.settings.show_description,
                  placeholder_media: placeholder_media,
                  content_position: content_card_position,
                  card_text_alignment: section.settings.card_text_alignment,
                  padded_content: padded_content
                -%}
              </div>
            {%- endfor -%}
          {%- else -%}
            {%- assign columns_desktop = section.settings.columns_desktop -%}
            {%- for i in (1..columns_desktop) -%}
              {%- liquid
                assign placeholder_media_index = forloop.index0 | modulo: 6 | plus: 1
                assign placeholder_media = 'collection-' | append: placeholder_media_index
              -%}
              <div class="swiper-slide">
                {%- render 'card-collection',
                  block: block,
                  card_collection: block.settings.collection,
                  card_vertical_text_alignment: section.settings.vertical_text_alignment,
                  settings_card_scheme: color_scheme_card,
                  card_image_ratio: section.settings.image_ratio,
                  show_description: section.settings.show_description,
                  placeholder_media: placeholder_media,
                  content_position: content_card_position,
                  card_text_alignment: section.settings.card_text_alignment,
                  placeholder_product: true,
                  padded_content: padded_content
                -%}
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
        {%- if is_slider -%}
          <div class="swiper-button-next m-swiper__arrow m-swiper__arrow--next">
            {%- render 'icon-arrow-right' -%}
          </div>
          <div class="swiper-button-prev m-swiper__arrow m-swiper__arrow--prev">{%- render 'icon-arrow-left' -%}</div>
        {%- endif -%}
      </div>
      {%- if is_slider -%}
        <script type="application/json" data-swiper>
          {{ slider_options | strip_newlines | remove: " " }}
        </script>
      {%- endif -%}
    </div>
    {%- if section.settings.btn_label != blank and section.settings.btn_url -%}
      <div class="o-collection-list__footer o-section__{{ section.settings.section_width }} u-text-{{ section.settings.content_alignment }}">
        <div class="grid grid--{{ section.settings.content_position }}-h">
          <div class="grid__col-12 grid__col-lg-{{ section.settings.content_width }}">
            <a
              class="{% if section.settings.btn_style == "line" %} a-link {% else %} a-btn a-btn--{{ section.settings.btn_style }}{% endif %} {% if section.settings.btn_icon %}a-btn--has-icon{% endif %} {% if settings.enable_animation %}js-animation a-animation a-animation--fade-up{% endif %}"
              href="{{ section.settings.btn_url }}"
            >
              <span>{{- section.settings.btn_label -}}</span>
              {% if section.settings.btn_icon %}
                {%- render 'icon-arrow-right' -%}
              {%- endif %}
            </a>
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:collections_list.name",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.headers.section.content"
    },
    {
      "type": "text",
      "id": "section_id",
      "label": "t:sections.all.section_id.label",
      "info": "t:sections.all.section_id.info"
    },
    {
      "type": "header",
      "content": "t:sections.all.headers.spacing.content"
    },
    {
      "type": "range",
      "id": "section_padding_top_desktop",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 80,
      "unit": "px",
      "label": "t:sections.all.padding.top.desktop.label"
    },
    {
      "type": "range",
      "id": "section_padding_bottom_desktop",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 80,
      "unit": "px",
      "label": "t:sections.all.padding.bottom.desktop.label"
    },
    {
      "type": "range",
      "id": "section_padding_top_mobile",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 40,
      "unit": "px",
      "label": "t:sections.all.padding.top.mobile.label",
      "info": "t:sections.all.padding.top.mobile.info"
    },
    {
      "type": "range",
      "id": "section_padding_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 40,
      "unit": "px",
      "label": "t:sections.all.padding.bottom.mobile.label",
      "info": "t:sections.all.padding.bottom.mobile.info"
    },
    {
      "type": "header",
      "content": "t:sections.all.headers.color.content"
    },
    {
      "type": "checkbox",
      "id": "invert_navigation_color",
      "label": "t:sections.all.invert_navigation_color.label",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:collections_list.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.headers.collection.content"
    },
    {
      "type": "collection_list",
      "id": "collection_list",
      "label": "t:collections_list.settings.collection_list.label",
      "limit": 20,
      "info": "t:collections_list.settings.collection_list.info"
    },
    {
      "type": "header",
      "content": "t:sections.all.headers.layout.content"
    },
    {
      "type": "select",
      "id": "display_mode",
      "label": "t:collections_list.settings.display_mode.label",
      "options": [
        {
          "value": "grid",
          "label": "t:collections_list.settings.display_mode.options.grid.label"
        },
        {
          "value": "slider",
          "label": "t:collections_list.settings.display_mode.options.slider.label"
        }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:collections_list.settings.section_width.label",
      "options": [
        {
          "value": "constrict",
          "label": "t:collections_list.settings.section_width.options.constrict.label"
        },
        {
          "value": "page-width",
          "label": "t:collections_list.settings.section_width.options.page_width.label"
        }
      ],
      "default": "constrict"
    },
    {
      "type": "range",
      "id": "content_width",
      "min": 4,
      "max": 12,
      "step": 1,
      "label": "t:collections_list.settings.content_width.label",
      "info": "t:collections_list.settings.content_width.info",
      "default": 10
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "t:collections_list.settings.content_position.label",
      "options": [
        {
          "value": "left",
          "label": "t:collections_list.settings.content_position.options.left.label"
        },
        {
          "value": "center",
          "label": "t:collections_list.settings.content_position.options.center.label"
        },
        {
          "value": "right",
          "label": "t:collections_list.settings.content_position.options.right.label"
        }
      ],
      "default": "left"
    },
    {
      "type": "text_alignment",
      "id": "content_alignment",
      "label": "t:collections_list.settings.content_alignment.label",
      "default": "left"
    },
    {
      "type": "header",
      "content": "t:sections.all.headers.grid.content"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "t:collections_list.settings.columns_desktop.label",
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:collections_list.settings.columns_mobile.label",
      "options": [
        {
          "value": "1",
          "label": "t:collections_list.settings.columns_mobile.options.1.label"
        },
        {
          "value": "2",
          "label": "t:collections_list.settings.columns_mobile.options.2.label"
        }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "column_gap_desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 20,
      "unit": "px",
      "label": "t:sections.all.grid.column_gap.desktop.label"
    },
    {
      "type": "range",
      "id": "row_gap_desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 20,
      "unit": "px",
      "label": "t:sections.all.grid.row_gap.desktop.label",
      "visible_if": "{{ section.settings.display_mode == 'grid' }}"
    },
    {
      "type": "range",
      "id": "column_gap_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 20,
      "unit": "px",
      "label": "t:sections.all.grid.column_gap.mobile.label"
    },
    {
      "type": "range",
      "id": "row_gap_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 20,
      "unit": "px",
      "label": "t:sections.all.grid.row_gap.mobile.label",
      "visible_if": "{{ section.settings.display_mode == 'grid' }}"
    },
    {
      "type": "header",
      "content": "t:collections_list.settings.header.collection_card.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme_card",
      "label": "t:collections_list.settings.color_scheme_card.label",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "t:collections_list.settings.show_description.label",
      "default": true
    },
    {
      "type": "select",
      "id": "content_card_position",
      "label": "t:collections_list.settings.content_card_position.label",
      "options": [
        {
          "value": "on-card",
          "label": "t:collections_list.settings.content_card_position.options.on_card.label"
        },
        {
          "value": "below-card",
          "label": "t:collections_list.settings.content_card_position.options.below_card.label"
        }
      ],
      "default": "below-card"
    },
    {
      "type": "select",
      "id": "vertical_text_alignment",
      "label": "t:collections_list.settings.vertical_text_alignment.label",
      "info": "t:collections_list.settings.vertical_text_alignment.info",
      "options": [
        {
          "value": "top",
          "label": "t:collections_list.settings.vertical_text_alignment.options.top.label"
        },
        {
          "value": "center",
          "label": "t:collections_list.settings.vertical_text_alignment.options.center.label"
        },
        {
          "value": "bottom",
          "label": "t:collections_list.settings.vertical_text_alignment.options.bottom.label"
        }
      ],
      "default": "bottom"
    },
    {
      "type": "text_alignment",
      "id": "card_text_alignment",
      "label": "t:collections_list.settings.card_text_alignment.label",
      "default": "left"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:collections_list.settings.image_ratio.label",
      "options": [
        {
          "value": "default",
          "label": "t:sections.all.media_ratio.options.default.label"
        },
        {
          "value": "1x1",
          "label": "t:sections.all.media_ratio.options.1_x_1.label"
        },
        {
          "value": "2x3",
          "label": "t:sections.all.media_ratio.options.2_x_3.label"
        },
        {
          "value": "3x2",
          "label": "t:sections.all.media_ratio.options.3_x_2.label"
        },
        {
          "value": "4x3",
          "label": "t:sections.all.media_ratio.options.4_x_3.label"
        },
        {
          "value": "4x5",
          "label": "t:sections.all.media_ratio.options.4_x_5.label"
        },
        {
          "value": "16x9",
          "label": "t:sections.all.media_ratio.options.16_x_9.label"
        }
      ],
      "default": "1x1"
    },
    {
      "type": "header",
      "content": "t:sections.all.headers.content.content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:collections_list.settings.heading.label",
      "default": "t:collections_list.settings.heading.default"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:collections_list.settings.heading_size.label",
      "options": [
        {
          "value": "h3",
          "label": "t:collections_list.settings.heading_size.options.h_3.label"
        },
        {
          "value": "h2",
          "label": "t:collections_list.settings.heading_size.options.h_2.label"
        },
