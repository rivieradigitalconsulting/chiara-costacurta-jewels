    {
      "type": "checkbox",
      "id": "btn_icon",
      "label": "t:collections_list.settings.btn_icon.label",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "collection_item",
      "name": "t:collections_list.blocks.collection_item.collection_item.name",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:collections_list.blocks.collection_item.collection_item.settings.collection.label"
