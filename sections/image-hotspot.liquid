{%- render '_styles-section', section: section -%}
{%- liquid
  assign color_scheme = section.settings.color_scheme
  assign standard_color_scheme = settings.color_schemes['scheme-1']

  if section.settings.media_position == 'left'
    assign media_position = 'left'
    assign content_position = 'right'
  elsif section.settings.media_position == 'right'
    assign media_position = 'right'
    assign content_position = 'left'
  endif

  assign display_mode = section.settings.display_mode
  assign technical_image = section.settings.technical_image
  assign dots_click_action = section.settings.dots_click_action

  assign ratio = section.settings.media_ratio
  assign ratio_class = 'a-img__ratio--' | append: ratio
  assign placeholder_media_classes = 'a-img__ratio--' | append: ratio | append: ' a-placeholder-media'

  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif

  assign headings = section.blocks | where: 'type', 'heading'
  assign captions = section.blocks | where: 'type', 'caption'
  assign paragraphs = section.blocks | where: 'type', 'paragraph'
  assign buttons = section.blocks | where: 'type', 'button'
  assign products = section.blocks | where: 'type', 'product'
  assign product_count = products | size
  assign product_lists = ''
  assign product_dots = ''
  assign linked_products_count = 0

  for block in products
    assign p = all_products[block.settings.product]
    assign combined_section_id = section.id | append: p.id
    assign horizontal_position = block.settings.horizontal_position
    assign vertical_position = block.settings.vertical_position

    capture product_list
      echo '<template id="{TEMPLATE_ID}">' | replace: '{TEMPLATE_ID}', combined_section_id
      echo '<div class="m-image-hotspot-sidebar__product">'
      render 'product-list', product: p, section_id: section.id, color_scheme: color_scheme
      echo '</div>'
      echo '</template>'
    endcapture

    capture product_dot
      assign dot_color = section.settings.dot_color

      capture dot_style
        echo 'left:' | append: horizontal_position | append: '%;'
        echo 'top:' | append: vertical_position | append: '%;'
      endcapture

      capture dot_props
        echo ' style="' | append: dot_style | append: '"'
        echo ' data-combined-section-id="' | append: combined_section_id | append: '"'
        echo ' aria-label="' | append: p.title | append: '"'
        echo ' data-action="' | append: dots_click_action | append: '"'
      endcapture

      echo '<button class="o-image-hotspot__dot o-image-hotspot__dot--{COLOR} js-image-hotspot-dot" {PROPS}></button>' | replace: '{COLOR}', dot_color | replace: '{PROPS}', dot_props
    endcapture

    assign product_dots = product_dots | append: product_dot

    if p != empty
      assign product_lists = product_lists | append: product_list
      assign linked_products_count = linked_products_count | plus: 1
    endif
  endfor
-%}

{{ 'product-list-style.css' | asset_url | stylesheet_tag }}
{{ 'image-hotspot-sidebar-style.css' | asset_url | stylesheet_tag }}
{{ 'image-hotspot-style.css' | asset_url | stylesheet_tag }}
<script src="{{ 'image-hotspot-script.min.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-form-script.min.js' | asset_url }}" defer="defer"></script>

<div
  class="o-image-hotspot o-section js-image-hotspot u-color--{{ color_scheme }}"
  {% if section.settings.invert_navigation_color %}
    data-invert-navigation
  {% endif %}
  {% if section.settings.section_id != blank %}
    id="{{ section.settings.section_id | handleize }}"
  {% endif %}
>
  {%- render 'section-bg-image', section: section -%}
  <div class="o-image-hotspot__inner o-section__constrict">
    <div class="grid grid--{{ section.settings.content_vertical_position }}-v grid--no-wrap-md">
      {%- if headings != blank or captions != blank or paragraphs != blank or buttons != blank -%}
        <div class="grid__col-12 grid__col-md-6 o-image-hotspot__content-position--{{ content_position }} ">
          <div class="o-image-hotspot__content u-text-{{ section.settings.content_alignment }}">
            {%- liquid
              for block in section.blocks
                capture block_styles
                  render '_styles-blocks', block: block
                endcapture
                case block.type
                  when 'caption'
                    render 'block-caption', block: block, block_styles: block_styles, block_class: 'o-mwt__caption'
                  when 'heading'
                    render 'block-heading', block: block, block_styles: block_styles, block_class: 'o-mwt__heading'
                  when 'paragraph'
                    render 'block-text', block: block, block_styles: block_styles, block_class: 'o-mwt__text'
                  when 'button'
                    if block.settings.btn_label != blank
                      render 'block-button', block: block, block_styles: block_styles, block_class: 'o-mwt__button'
                    endif
                endcase
              endfor
            -%}
          </div>
        </div>
      {%- endif -%}

      <div class="o-image-hotspot__image o-image-hotspot__technical-image grid__col-12 grid__col-md-6 o-image-hotspot__media-position--{{ media_position }} {% if settings.enable_animation %}js-animation a-animation a-animation--fade-up{% endif %}">
        {%- if technical_image != blank -%}
          {%- assign widths = '165, 360, 535, 750, 1070, 1500' -%}
          {%- capture sizes -%}
            (min-width: 750px) calc((100vw) / 2), calc((100vw) / 2)
          {%- endcapture -%}

          {{
            technical_image
            | image_url: width: 1500
            | image_tag:
              class: ratio_class,
              loading: 'lazy',
              sizes: sizes,
              widths: widths,
              fetchpriority: fetch_priority
          }}

        {% else %}
          <div class="o-image-hotspot__image">
            {{ 'image' | placeholder_svg_tag: placeholder_media_classes }}
          </div>
        {%- endif -%}

        {%- if display_mode == 'dots' -%}
          {{ product_dots }}
        {%- endif -%}

        {%- if display_mode == 'button' and product_count > 0 -%}
          <button
            class="o-image-hotspot__button {% if section.settings.btn_style == "line" %} a-link {% else %} a-btn a-btn--{{ section.settings.btn_style }}{% endif %} js-image-hotspot-button"
            aria-label="{{ section.settings.btn_label }}"
            data-action="all"
          >
            {{ section.settings.btn_label }}
          </button>
        {%- endif -%}
      </div>
    </div>
  </div>

  <div class="o-image-hotspot__sidebar m-image-hotspot-sidebar js-image-hotspot-sidebar">
    <div class="m-image-hotspot-sidebar__content u-color--{{ color_scheme }}">
      <div class="m-image-hotspot-sidebar__header grid grid--no-wrap grid--center-v">
        {%- if section.settings.heading != blank -%}
          <p class="m-image-hotspot-sidebar__heading">
            {{ section.settings.heading | escape }}
          </p>
        {%- endif -%}
        <button
          class="u-unstyled-btn m-image-hotspot-sidebar__close js-image-hotspot-sidebar-close"
          aria-label="{{ "accessibility.close" | t }}"
        >
          {%- render 'icon-close' -%}
        </button>
      </div>
      {%- unless linked_products_count > 0 -%}
        <div class="m-image-hotspot-sidebar__empty">
          {%- if request.design_mode -%}
            {{ 'sections.image_hotspot.empty_list_admin' | t }}
          {%- else -%}
            {{ 'sections.image_hotspot.empty_list' | t }}
          {%- endif -%}
        </div>
      {%- endunless -%}
      <div class="m-image-hotspot-sidebar__products"></div>
      <div class="m-image-hotspot-sidebar__message js-image-hotspot-message">
        <span>{{ 'sections.image_hotspot.added_to_cart' | t }}</span>
      </div>
    </div>
    <span class="u-backdrop js-image-hotspot-sidebar-underlay"></span>

    {{ product_lists }}
  </div>
</div>

