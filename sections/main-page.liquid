{%- render '_styles-section', section: section -%}
{%- liquid
  assign color_scheme = section.settings.color_scheme
  assign standard_color_scheme = settings.color_schemes['scheme-1']
-%}
<section
  class="o-page o-section u-color--{{ color_scheme }}"
  {% if section.settings.invert_navigation_color %}
    data-invert-navigation
  {% endif %}
  {% if section.settings.section_id != blank %}
    id="{{ section.settings.section_id | handleize }}"
  {% endif %}
>
  <div class="o-page__inner o-section__constrict">
    <div class="grid grid--{{ section.settings.content_position }}-h">
      <div class="grid__col-12 grid__col-md-{{ section.settings.column_width }}">
        <div class="u-text-{{ section.settings.content_alignment }}">
          <h1 class="o-page__title {{ section.settings.heading_size }} {% if settings.enable_animation %}js-animation a-animation a-animation--fade-up{% endif %}">
            {{ page.title | escape }}
          </h1>
          <div class="o-page__content {{ section.settings.text_size }} rte {% if settings.enable_animation %}js-animation a-animation a-animation--fade-up{% endif %}">
            {{ page.content }}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:page.name",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.headers.section.content"
    },
    {
      "type": "text",
      "id": "section_id",
      "label": "t:sections.all.section_id.label",
      "info": "t:sections.all.section_id.info"
    },
    {
      "type": "header",
      "content": "t:sections.all.headers.spacing.content"
    },
    {
      "type": "range",
      "id": "section_padding_top_desktop",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 80,
      "unit": "px",
      "label": "t:sections.all.padding.top.desktop.label",
    },
    {
      "type": "range",
      "id": "section_padding_bottom_desktop",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 80,
      "unit": "px",
      "label": "t:sections.all.padding.bottom.desktop.label",
    },
    {
      "type": "range",
      "id": "section_padding_top_mobile",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 40,
      "unit": "px",
      "label": "t:sections.all.padding.top.mobile.label",
      "info": "t:sections.all.padding.top.mobile.info",
    },
    {
      "type": "range",
      "id": "section_padding_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 40,
      "unit": "px",
      "label": "t:sections.all.padding.bottom.mobile.label",
      "info": "t:sections.all.padding.bottom.mobile.info",
    },
    {
      "type": "header",
      "content": "t:sections.all.headers.color.content"
    },
    {
      "type": "checkbox",
      "id": "invert_navigation_color",
      "label": "t:sections.all.invert_navigation_color.label",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:page.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.headers.layout.content"
    },
    {
      "type": "range",
      "id": "column_width",
      "min": 6,
      "max": 12,
      "step": 1,
      "label": "t:page.settings.column_width.label",
      "info": "t:page.settings.column_width.info",
      "default": 10
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "t:page.settings.content_position.label",
      "options": [
        {
          "value": "left",
          "label": "t:page.settings.content_position.options.left.label"
        },
        {
          "value": "center",
          "label": "t:page.settings.content_position.options.center.label"
        },
        {
          "value": "right",
          "label": "t:page.settings.content_position.options.right.label"
        }
      ],
      "default": "center"
    },
    {
      "type": "text_alignment",
      "id": "content_alignment",
      "label": "t:page.settings.content_alignment.label",
      "default": "left"
    },
    {
      "type": "header",
      "content": "t:sections.all.headers.content.content"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:page.settings.heading_size.label",
      "options": [
        {
          "value": "h3",
          "label": "t:page.settings.heading_size.options.h_3.label"
        },
        {
          "value": "h2",
          "label": "t:page.settings.heading_size.options.h_2.label"
        },
        {
          "value": "h1",
          "label": "t:page.settings.heading_size.options.h_1.label"
        }
      ],
      "default": "h1"
    },
    {
      "type": "select",
      "id": "text_size",
      "label": "t:page.settings.text_size.label",
      "options": [
        {
          "value": "body-fs-sm",
          "label": "t:page.settings.text_size.options.body_fs_sm.label"
        },
        {
          "value": "body-fs-md",
          "label": "t:page.settings.text_size.options.body_fs_md.label"
        },
        {
          "value": "body-fs-lg",
          "label": "t:page.settings.text_size.options.body_fs_lg.label"
        }
      ],
      "default": "body-fs-md"
    }
  ]
}
{% endschema %}
