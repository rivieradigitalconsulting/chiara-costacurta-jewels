{%- render '_styles-section', section: section -%}
{{ 'marquee-style.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign color_scheme = section.settings.color_scheme
  assign standard_color_scheme = settings.color_schemes['scheme-1']
-%}

<section
  class="o-marquee o-section u-color--{{ color_scheme }} {% if section.settings.show_border %}o-marquee--border{% endif %} "
  {% if section.settings.invert_navigation_color %}
    data-invert-navigation
  {% endif %}
  {% if section.settings.section_id != blank %}
    id="{{ section.settings.section_id | handleize }}"
  {% endif %}
>
  <div
    class="{% if section.settings.section_width == 'constrict' %}o-section__constrict{% endif %}"
  >
    <div class="o-marquee__inner {% if section.settings.section_width == 'constrict' %}o-marquee__inner--constrict{% endif %} js-marquee {% if section.settings.show_fading_overlay_left_right %}o-marquee__inner--faded{% endif %}">
      <div class="grid grid--center-h grid--no-wrap o-marquee__grid">
        {%- assign blocks_count = section.blocks.size %}
        {%- assign total_repeats = 30 | divided_by: blocks_count | round %}

        {%- for i in (1..total_repeats) -%}
          {%- for block in section.blocks -%}
            <div
              class="o-marquee__item"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.title -%}
                <p class="o-marquee__title {{ section.settings.heading_size }}">{{ block.settings.title | escape }}</p>
              {%- endif -%}
            </div>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:marquee.name",
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.headers.section.content"
    },
    {
      "type": "text",
      "id": "section_id",
      "label": "t:sections.all.section_id.label",
      "info": "t:sections.all.section_id.info"
    },
    {
      "type": "header",
      "content": "t:sections.all.headers.spacing.content"
    },
    {
      "type": "range",
      "id": "section_padding_top_desktop",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 80,
      "unit": "px",
      "label": "t:sections.all.padding.top.desktop.label",
    },
    {
      "type": "range",
      "id": "section_padding_bottom_desktop",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 80,
      "unit": "px",
      "label": "t:sections.all.padding.bottom.desktop.label",
    },
    {
      "type": "range",
      "id": "section_padding_top_mobile",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 40,
      "unit": "px",
      "label": "t:sections.all.padding.top.mobile.label",
      "info": "t:sections.all.padding.top.mobile.info",
    },
    {
      "type": "range",
      "id": "section_padding_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 40,
      "unit": "px",
      "label": "t:sections.all.padding.bottom.mobile.label",
      "info": "t:sections.all.padding.bottom.mobile.info",
    },
    {
      "type": "header",
      "content": "t:sections.all.headers.color.content"
    },
    {
      "type": "checkbox",
      "id": "invert_navigation_color",
      "label": "t:sections.all.invert_navigation_color.label",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:marquee.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.headers.layout.content"
    },
    {
      "type": "checkbox",
      "id": "show_border",
      "label": "t:marquee.settings.show_border.label",
      "default": false
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:marquee.settings.section_width.label",
      "options": [
        {
          "value": "constrict",
          "label": "t:marquee.settings.section_width.options.constrict.label"
        },
        {
          "value": "page-width",
          "label": "t:marquee.settings.section_width.options.page_width.label"
        }
      ],
      "default": "constrict"
    },
    {
      "type": "checkbox",
      "id": "show_fading_overlay_left_right",
      "label": "t:marquee.settings.show_fading_overlay_left_right.label",
      "info": "t:marquee.settings.show_fading_overlay_left_right.info",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.all.headers.content.content"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:marquee.settings.heading_size.label",
      "options": [
        {
          "value": "h3",
          "label": "t:marquee.settings.heading_size.options.h_3.label"
        },
        {
          "value": "h2",
          "label": "t:marquee.settings.heading_size.options.h_2.label"
        },
        {
          "value": "h1",
          "label": "t:marquee.settings.heading_size.options.h_1.label"
        }
      ],
      "default": "h2"
    }
  ],
  "blocks": [
    {
      "type": "marquee_item",
      "name": "t:marquee.blocks.marquee_item.marquee_item.name",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:marquee.blocks.marquee_item.marquee_item.settings.title.label",
          "default": "t:marquee.blocks.marquee_item.marquee_item.settings.title.default"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:marquee.presets.marquee.name",
      "blocks": [
        {
          "type": "marquee_item"
        },
        {
          "type": "marquee_item"
        },
        {
          "type": "marquee_item"
        },
        {
          "type": "marquee_item"
        }
      ]
    }
  ]
}
{% endschema %}
