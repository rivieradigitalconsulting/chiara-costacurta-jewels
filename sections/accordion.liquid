{%- render '_styles-section', section: section -%}
{{ 'accordion-style.css' | asset_url | stylesheet_tag }}
<script src="{{ 'accordion-script.min.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign color_scheme = section.settings.color_scheme
  assign standard_color_scheme = settings.color_schemes['scheme-1']
-%}
<div
  class="o-accordion o-section u-color--{{ color_scheme }}"
  {% if section.settings.section_id != blank %}
    id="{{ section.settings.section_id | handleize }}"
  {% endif %}
  {% if section.settings.invert_navigation_color %}
    data-invert-navigation
  {% endif %}
>
  <div class="o-accordion__inner o-section__constrict">
    <div class="grid grid--{{ section.settings.content_position }}-h">
      <div class="grid__col-12 grid__col-md-{{ section.settings.column_width }}">
        <div class="o-accordion__content u-text-{{ section.settings.content_alignment }}">
          {%- if section.settings.heading != blank -%}
            <h2 class="o-accordion__heading {{ section.settings.heading_size }} {% if settings.enable_animation %}js-animation a-animation a-animation--fade-up{% endif %}">
              {{ section.settings.heading | escape }}
            </h2>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <div class="o-accordion__text rte {{ section.settings.text_size }} {% if settings.enable_animation %}js-animation a-animation a-animation--fade-up{% endif %}">
              {{ section.settings.text }}
            </div>
          {%- endif -%}
        </div>

        <div class="o-accordion__items">
          {%- for block in section.blocks -%}
            {%- liquid
              assign icon = block.settings.icon
              assign title = block.settings.title
              assign content = block.settings.content
            -%}

            {%- if content != blank -%}
              <div
                class="o-accordion__item m-accordion js-accordion {% if settings.enable_animation %}js-animation a-animation a-animation--fade-up{% endif %}"
                {{ block.shopify_attributes }}
              >
                <div class="m-accordion__header grid grid--center-v grid--no-wrap js-accordion-trigger" tabindex="0">
                  <h3 class="body-fs-md">{{ title }}</h3>
                  {%- render 'icon-pack', icon: icon -%}
                </div>
                <div class="m-accordion__content rte">
                  <div class="m-accordion__text">
                    {{ content }}
                  </div>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:accordion.name",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.headers.section.content"
    },
    {
      "type": "text",
      "id": "section_id",
      "label": "t:sections.all.section_id.label",
      "info": "t:sections.all.section_id.info"
    },
    {
      "type": "header",
      "content": "t:sections.all.headers.spacing.content"
    },
    {
      "type": "range",
      "id": "section_padding_top_desktop",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 80,
      "unit": "px",
      "label": "t:sections.all.padding.top.desktop.label",
    },
    {
      "type": "range",
      "id": "section_padding_bottom_desktop",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 80,
      "unit": "px",
      "label": "t:sections.all.padding.bottom.desktop.label",
    },
    {
      "type": "range",
      "id": "section_padding_top_mobile",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 40,
      "unit": "px",
      "label": "t:sections.all.padding.top.mobile.label",
      "info": "t:sections.all.padding.top.mobile.info",
    },
    {
      "type": "range",
      "id": "section_padding_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 40,
      "unit": "px",
      "label": "t:sections.all.padding.bottom.mobile.label",
      "info": "t:sections.all.padding.bottom.mobile.info",
    },
    {
      "type": "header",
      "content": "t:sections.all.headers.color.content"
    },
    {
      "type": "checkbox",
      "id": "invert_navigation_color",
      "label": "t:sections.all.invert_navigation_color.label",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:accordion.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.headers.layout.content"
    },
    {
      "type": "range",
      "id": "column_width",
      "min": 6,
      "max": 12,
      "step": 1,
      "default": 10,
      "label": "t:accordion.settings.column_width.label",
      "info": "t:accordion.settings.column_width.info"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "t:accordion.settings.content_position.label",
      "options": [
        {
          "value": "left",
          "label": "t:accordion.settings.content_position.options.left.label"
        },
        {
          "value": "center",
          "label": "t:accordion.settings.content_position.options.center.label"
        },
        {
          "value": "right",
          "label": "t:accordion.settings.content_position.options.right.label"
        }
      ],
      "default": "center"
    },
    {
      "type": "text_alignment",
      "id": "content_alignment",
      "label": "t:accordion.settings.content_alignment.label",
      "default": "center"
    },
    {
      "type": "header",
      "content": "t:accordion.settings.header.content.content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:accordion.settings.heading.label",
      "default": "t:accordion.settings.heading.default"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:accordion.settings.heading_size.label",
      "options": [
        {
          "value": "h3",
          "label": "t:accordion.settings.heading_size.options.h_3.label"
        },
        {
          "value": "h2",
          "label": "t:accordion.settings.heading_size.options.h_2.label"
        },
        {
          "value": "h1",
          "label": "t:accordion.settings.heading_size.options.h_1.label"
        }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:accordion.settings.text.label"
    },
    {
      "type": "select",
      "id": "text_size",
      "label": "t:featured_collection.settings.text_size.label",
      "options": [
        {
          "value": "body-fs-sm",
          "label": "t:featured_collection.settings.text_size.options.body_fs_sm.label"
        },
        {
          "value": "body-fs-md",
          "label": "t:featured_collection.settings.text_size.options.body_fs_md.label"
        },
        {
          "value": "body-fs-lg",
          "label": "t:featured_collection.settings.text_size.options.body_fs_lg.label"
        }
      ],
      "default": "body-fs-md"
    }
  ],
  "blocks": [
    {
      "type": "accordion_item",
      "name": "t:accordion.blocks.accordion_item.item.name",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:accordion.blocks.accordion_item.item.settings.icon.label",
          "options": [
            {
              "value": "caret",
              "label": "t:accordion.blocks.accordion_item.item.settings.icon.options.caret.label"
            },
            {
              "value": "plus",
              "label": "t:accordion.blocks.accordion_item.item.settings.icon.options.plus.label"
            }
          ],
          "default": "plus"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:accordion.blocks.accordion_item.item.settings.title.label",
          "default": "t:accordion.blocks.accordion_item.item.settings.title.default"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "t:accordion.blocks.accordion_item.item.settings.content.label",
          "default": "t:accordion.blocks.accordion_item.item.settings.content.default"
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "t:accordion.presets.accordion.name",
      "blocks": [
        {
          "type": "accordion_item"
        },
        {
          "type": "accordion_item"
        },
        {
          "type": "accordion_item"
        }
      ]
    }
  ]
}
{% endschema %}
