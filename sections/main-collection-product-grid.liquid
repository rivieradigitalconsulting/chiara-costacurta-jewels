{%- render '_styles-section', section: section -%}
{%- liquid
  assign color_scheme = section.settings.color_scheme
  assign filter_color_scheme = section.settings.filter_drawer_color_scheme
  assign standard_color_scheme = settings.color_schemes['scheme-1']

  assign enable_filtering = section.settings.enable_filtering
  assign enable_sorting = section.settings.enable_sorting
  assign enable_product_count = section.settings.enable_product_count
  assign quick_add = settings.product_card_enable_quick_add

  assign fetch_priority = 'auto'
  assign loading = 'lazy'
  if section.index == 1
    assign fetch_priority = 'high'
    assign loading = 'eager'
  endif

  assign widths = '165, 360, 535, 750, 1070, 1500'
-%}

{%- capture sizes -%}
    (min-width: 750px) calc((100vw) / 2), calc((100vw) / 2)
 {%- endcapture -%}

{{ 'main-collection-grid-style.css' | asset_url | stylesheet_tag }}
{{ 'product-card-style.css' | asset_url | stylesheet_tag }}
{{ 'cta-card-style.css' | asset_url | stylesheet_tag }}
{{ 'price-style.css' | asset_url | stylesheet_tag }}

<script src="{{ 'filter-script.min.js' | asset_url }}" defer="defer"></script>

{%- if quick_add -%}
  {{ 'product-quick-add-style.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'product-form-script.min.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

<div
  class="o-main-collection-grid {% if enable_filtering %}o-main-collection-grid--has-filters{% endif %} o-section u-color--{{ color_scheme }}"
  {% if section.settings.invert_navigation_color %}
    data-invert-navigation
  {% endif %}
  {% if section.settings.section_id != blank %}
    id="{{ section.settings.section_id | handleize }}"
  {% endif %}
>
  <div class="o-main-collection-grid__inner o-section__constrict">
    <div class="o-main-collection-grid__wrapper">
      <div
        class="o-main-collection-grid__filter"
      >
        {%- liquid
          if enable_filtering
            render 'filter', results: collection, enable_filtering: enable_filtering, enable_sorting: enable_sorting, enable_product_count: enable_product_count, filter_color_scheme: filter_color_scheme
          endif
        -%}
      </div>
      <div class="o-main-collection-grid__products-container js-product-grid-container">
        {%- if collection.products.size == 0 -%}
          <div
            class="o-main-collection-grid o-main-collection-grid--empty js-product-grid-products grid__col-12"
            data-id="{{ section.id }}"
          >
            <div class="o-main-collection-grid__heading-wrapper u-text-center">
              <h2 class="o-main-collection-grid__heading h3">
                {{ 'sections.collection_template.empty' | t -}}
              </h2>
              <p>
                {{ 'sections.collection_template.use_fewer_filters_html' | t: link: collection.url, class: 'a-link' }}
              </p>
            </div>
          </div>
        {%- else -%}
          <div class="o-main-collection-grid__products-wrapper grid__col-12">
            {%- paginate collection.products by section.settings.products_per_page -%}
              <div
                class="o-main-collection-grid__products js-product-grid-products item-grid"
                id="product-grid"
                data-type="{{ section.settings.grid_type }}"
                data-id="{{ section.id }}"
                data-columns-desktop="{{ section.settings.columns_desktop }}"
                data-columns-mobile="{{ section.settings.columns_mobile }}"
              >
                {%- liquid
                  for product in collection.products
                    assign placeholder_media_index = forloop.index0 | modulo: 6 | plus: 1
                    assign placeholder_media = 'product-' | append: placeholder_media_index
                    assign index = forloop.index

                    render 'product-grid-cta-loop', section: section, index: index, fetch_priority: fetch_priority, sizes: sizes, widths: widths, loading: loading

                    render 'product-card', card_product: product, section_id: section.id, collection: collection, placeholder_media: placeholder_media
                  endfor
                -%}
              </div>

              {%- liquid
                if paginate.pages > 1
                  render 'pagination', paginate: paginate, anchor: ''
                endif
              -%}
            {%- endpaginate -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

