          "label": "t:multicolumn.settings.text_size.options.body_fs_lg.label"
        }
      ],
      "default": "body-fs-md"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "t:multicolumn.settings.btn_label.label",
      "default": "t:multicolumn.settings.btn_label.default"
    },
    {
      "type": "url",
      "id": "btn_url",
      "label": "t:multicolumn.settings.btn_url.label"
    },
    {
      "type": "select",
      "id": "btn_style",
      "label": "t:multicolumn.settings.btn_style.label",
