        {
          "value": "2",
          "label": "t:multicolumn.settings.columns_mobile.options.2.label"
        }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "column_gap_desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 20,
      "unit": "px",
      "label": "t:sections.all.grid.column_gap.desktop.label"
    },
    {
      "type": "range",
