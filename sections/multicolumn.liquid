    },
    {
      "type": "header",
      "content": "t:sections.all.headers.color.content"
    },
    {
      "type": "checkbox",
      "id": "invert_navigation_color",
      "label": "t:sections.all.invert_navigation_color.label",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:multicolumn.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.headers.layout.content"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:multicolumn.settings.section_width.label",
      "options": [
        {
          "value": "constrict",
          "label": "t:multicolumn.settings.section_width.options.constrict.label"
        },
        {
          "value": "page-width",
          "label": "t:multicolumn.settings.section_width.options.page_width.label"
        }
      ],
      "default": "constrict"
    },
    {
      "type": "text_alignment",
      "id": "columns_alignment",
      "label": "t:multicolumn.settings.columns_alignment.label",
      "default": "left"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:multicolumn.settings.image_ratio.label",
      "options": [
        {
          "value": "default",
          "label": "t:sections.all.media_ratio.options.default.label"
        },
        {
          "value": "1x1",
          "label": "t:sections.all.media_ratio.options.1_x_1.label"
        },
        {
          "value": "2x3",
          "label": "t:sections.all.media_ratio.options.2_x_3.label"
        },
        {
          "value": "3x2",
          "label": "t:sections.all.media_ratio.options.3_x_2.label"
        },
        {
          "value": "4x3",
          "label": "t:sections.all.media_ratio.options.4_x_3.label"
        },
        {
          "value": "4x5",
          "label": "t:sections.all.media_ratio.options.4_x_5.label"
        },
        {
          "value": "16x9",
          "label": "t:sections.all.media_ratio.options.16_x_9.label"
        }
      ],
      "default": "4x5"
    },
    {
      "type": "range",
      "id": "content_width",
      "min": 4,
      "max": 12,
      "step": 1,
      "label": "t:multicolumn.settings.content_width.label",
      "info": "t:multicolumn.settings.content_width.info",
      "default": 10
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "t:multicolumn.settings.content_position.label",
      "options": [
        {
          "value": "left",
          "label": "t:multicolumn.settings.content_position.options.left.label"
        },
        {
          "value": "center",
          "label": "t:multicolumn.settings.content_position.options.center.label"
        },
