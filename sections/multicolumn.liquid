    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:multicolumn.settings.text.label",
      "default": "t:multicolumn.settings.text.default"
    },
    {
      "type": "select",
      "id": "text_size",
      "label": "t:multicolumn.settings.text_size.label",
      "options": [
        {
          "value": "body-fs-sm",
          "label": "t:multicolumn.settings.text_size.options.body_fs_sm.label"
        },
        {
          "value": "body-fs-md",
          "label": "t:multicolumn.settings.text_size.options.body_fs_md.label"
        },
