{%- render '_styles-section', section: section -%}
{{ 'multicolumn-style.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign color_scheme = section.settings.color_scheme
  assign standard_color_scheme = settings.color_schemes['scheme-1']

  assign aspect_ratio_class = 'a-img__ratio--' | append: section.settings.image_ratio

  assign placeholder_media_classes = 'a-img__ratio--' | append: section.settings.image_ratio | append: ' a-placeholder-media'
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif

  assign padded_content = false

  if section.settings.section_width == 'page-width'
    assign padded_content = true
  endif
-%}

<section
  class="o-multicolumn o-section u-color--{{ color_scheme }}"
  {% if section.settings.invert_navigation_color %}
    data-invert-navigation
  {% endif %}
  {% if section.settings.section_id != blank %}
    id="{{ section.settings.section_id | handleize }}"
  {% endif %}
>
  <div
    class="o-multicolumn__inner"
  >
    {%- if section.settings.heading != blank or section.settings.text != blank -%}
      <div class="o-multicolumn__content o-section__{{ section.settings.section_width }} u-text-{{ section.settings.content_alignment }}">
        <div class="grid grid--{{ section.settings.content_position }}-h">
          <div class="grid__col-12 grid__col-lg-{{ section.settings.content_width }}">
            {%- if section.settings.heading != blank -%}
              <h2
                class="o-featured-collection__heading {{ section.settings.heading_size }} {% if settings.enable_animation %}js-animation a-animation a-animation--fade-up{% endif %}"
              >
                {{ section.settings.heading | escape }}
              </h2>
            {%- endif -%}
            {%- if section.settings.text != blank -%}
              <div
                class="o-featured-collection__text rte {{ section.settings.text_size }} {% if settings.enable_animation %}js-animation a-animation a-animation--fade-up{% endif %}"
              >
                {{ section.settings.text }}
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endif -%}
    <div class="o-multicolumn__grid {% if section.settings.section_width == 'constrict' %}o-section__constrict{% endif %}">
      <div class="grid o-multicolumn__items item-grid">
        {%- for block in section.blocks -%}
          <div
            class="o-multicolumn__item {% if settings.enable_animation %}js-animation a-animation a-animation--fade-up{% endif %}"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.image -%}
              {%- liquid
                assign number_of_columns = section.settings.columns_desktop
                assign number_of_columns_mobile = section.settings.columns_mobile

                # Calculate container width based on section_width setting
                if section.settings.section_width == 'page-width'
                  assign container_width = 1440
                else
                  assign container_width = 1200
                endif
              -%}

              {% capture sizes %}
                (max-width: 639px) calc((100vw - {{ section.settings.column_gap_mobile | times: number_of_columns_mobile | minus: section.settings.column_gap_mobile }}px) / {{ number_of_columns_mobile }}),
                (max-width: 1023px) calc((100vw - {{ section.settings.column_gap_desktop | times: number_of_columns | minus: section.settings.column_gap_desktop }}px) / {{ number_of_columns }}),
                100vw
              {% endcapture %}
              {%- assign widths = '165, 360, 535, 750, 1070, 1500, 2000, 2400' -%}

              <div class="o-multicolumn__image">
                {{
                  block.settings.image
                  | image_url: width: 2400
                  | image_tag:
                    class: aspect_ratio_class,
                    loading: 'lazy',
                    sizes: sizes,
                    widths: widths,
                    fetchpriority: fetch_priority
                }}
              </div>
            {%- else -%}
              <div class="o-multicolumn__image">
                {%- assign placeholder_classes = aspect_ratio_class | append: ' a-placeholder-media' -%}
                {{ 'image' | placeholder_svg_tag: placeholder_classes }}
              </div>
            {% endif %}
            {%- if block.settings.title != blank or block.settings.text != blank or block.settings.btn_url != blank -%}
              <div class="o-multicolumn__information {% if padded_content %}o-multicolumn__information--padded{% endif %} u-text-{{ section.settings.columns_alignment }}">
                {%- if block.settings.title != blank -%}
                  <p class="o-multicolumn__title h4">{{ block.settings.title | escape }}</p>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="o-multicolumn__text">{{ block.settings.text }}</div>
                {%- endif -%}

                {%- liquid
                  assign has_button = false

                  if block.settings.btn_label != blank and block.settings.btn_url != blank
                    assign has_button = true
                  endif
                -%}

                {%- if has_button -%}
                  <a
                    class="{% if block.settings.btn_style == "line" %} a-link {% else %} a-btn a-btn--{{ block.settings.btn_style }}{% endif %} {% if block.settings.btn_icon %}a-btn--has-icon{% endif %}"
                    href="{{ block.settings.btn_url }}"
                  >
                    {{- block.settings.btn_label -}}
                    {% if block.settings.btn_icon %}{%- render 'icon-arrow-right' -%}{% endif %}
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
    {%- if section.settings.btn_url != blank and section.settings.btn_label != blank -%}
      <div class="o-multicolumn__footer o-section__{{ section.settings.section_width }} u-text-{{ section.settings.content_alignment }}">
        <div class="grid grid--{{ section.settings.content_position }}-h">
          <div class="grid__col-12 grid__col-lg-{{ section.settings.content_width }}">
            {%- if section.settings.btn_label != blank and section.settings.btn_url -%}
              <a
                class="{% if section.settings.btn_style == "line" %} a-link {% else %} a-btn a-btn--{{ section.settings.btn_style }}{% endif %} {% if section.settings.btn_icon %}a-btn--has-icon{% endif %}"
                href="{{ section.settings.btn_url }}"
              >
                <span>{{- section.settings.btn_label -}}</span>
                {% if section.settings.btn_icon %}
                  {%- render 'icon-arrow-right' -%}
                {%- endif %}
              </a>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:multicolumn.name",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.headers.section.content"
    },
    {
      "type": "text",
      "id": "section_id",
      "label": "t:sections.all.section_id.label",
      "info": "t:sections.all.section_id.info"
    },
    {
      "type": "header",
      "content": "t:sections.all.headers.spacing.content"
    },
    {
      "type": "range",
      "id": "section_padding_top_desktop",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 80,
      "unit": "px",
      "label": "t:sections.all.padding.top.desktop.label"
    },
    {
      "type": "range",
      "id": "section_padding_bottom_desktop",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 80,
      "unit": "px",
      "label": "t:sections.all.padding.bottom.desktop.label"
    },
    {
      "type": "range",
      "id": "section_padding_top_mobile",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 40,
      "unit": "px",
      "label": "t:sections.all.padding.top.mobile.label",
      "info": "t:sections.all.padding.top.mobile.info"
    },
    {
      "type": "range",
      "id": "section_padding_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 40,
      "unit": "px",
      "label": "t:sections.all.padding.bottom.mobile.label",
