{%- render '_styles-section', section: section -%}
{{ 'usp-style.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign color_scheme = section.settings.color_scheme
  assign standard_color_scheme = settings.color_schemes['scheme-1']

  assign columns_mobile = section.settings.columns_mobile | plus: 0
  assign columns_desktop = section.settings.columns_desktop | plus: 0
  assign column_gap_mobile = section.settings.column_gap_mobile | plus: 0
  assign column_gap_desktop = section.settings.column_gap_desktop | plus: 0
  assign row_gap_mobile = section.settings.row_gap_mobile | plus: 0
  assign row_gap_desktop = section.settings.row_gap_desktop | plus: 0

  assign display_mode = section.settings.display_mode

  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif

  assign is_slider = false

  if display_mode == 'slider'
    assign is_slider = true
  endif
-%}

{%- capture slider_options -%}
  {
    "direction": "horizontal",
    "slidesPerView": {{ columns_mobile }},
    "speed": 600,
    "loop": true,
    "autoHeight": true,
    "spaceBetween": {{ column_gap_mobile }},
    {%- if section.settings.autoplay -%}
      "autoplay": {
        "delay": 5000,
        "disableOnInteraction": false
      },
    {%- endif -%}
    "breakpoints": {
      "768": {
        "loop": false,
        "spaceBetween": {{ column_gap_desktop }},
        "slidesPerView": {{ columns_desktop }}
      }
    }
  }
{%- endcapture -%}

<section
  class="o-usp o-section u-color--{{ color_scheme }} {% if section.settings.show_border %}o-usp--border{% endif %}"
  {% if section.settings.invert_navigation_color %}
    data-invert-navigation
  {% endif %}
  {% if section.settings.section_id != blank %}
    id="{{ section.settings.section_id | handleize }}"
  {% endif %}
>
  <div
    class="o-section__constrict"
  >
    <div
      class="o-usp__slider-wrapper o-usp__slider-wrapper--{{ display_mode }} js-usps {% if is_slider %} swiper m-swiper {% endif %}"
      data-columns="{{ columns_desktop }}"
      data-columns-mobile="{{ columns_mobile }}"
    >
      <div class="{%- if is_slider %}item-flex-grid swiper-wrapper{% else %}item-grid{% endif %}">
        {%- for block in section.blocks -%}
          <div
            class="m-usp swiper-slide u-text-{{ section.settings.content_alignment }} {% if settings.enable_animation %}js-animation a-animation a-animation--fade-up{% endif %}"
            {{ block.shopify_attributes }}
          >
            <div class="m-usp__inner m-usp__icon-alignment--{{ section.settings.icon_alignment }}">
              {% if block.settings.image %}
                <div class="m-usp__image">
                  {{
                    block.settings.image
                    | image_url: width: 50
                    | image_tag: fetchpriority: fetch_priority, loading: 'lazy'
                  }}
                </div>
              {%- elsif block.settings.icon_select != 'none' -%}
                <div class="m-usp__icon">
                  {%- render 'icon-pack', icon: block.settings.icon_select -%}
                </div>
              {%- endif -%}
              {%- if block.settings.title or block.settings.text %}
                <div class="m-usp__content">
                  {%- if block.settings.title -%}
                    <p class="m-usp__title h3">{{ block.settings.title | escape }}</p>
                  {%- endif -%}
                  {%- if block.settings.text -%}
                    <div class="m-usp__text">{{ block.settings.text }}</div>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
    {%- if is_slider -%}
      <script type="application/json" data-swiper>
        {{ slider_options | strip_newlines | remove: " " }}
      </script>
    {%- endif -%}
  </div>
</section>

