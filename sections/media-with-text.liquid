{%- render '_styles-section', section: section -%}
{{ 'media-with-text-style.css' | asset_url | stylesheet_tag }}
{{ 'accordion-style.css' | asset_url | stylesheet_tag }}

<script src="{{ 'video-script.min.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign color_scheme = section.settings.color_scheme
  assign standard_color_scheme = settings.color_schemes['scheme-1']

  if section.settings.media_position == 'left'
    assign media_position = 'left'
    assign content_position = 'right'
  elsif section.settings.media_position == 'right'
    assign media_position = 'right'
    assign content_position = 'left'
  endif

  assign aspect_ratio_class = 'a-img__ratio--' | append: section.settings.image_ratio
  assign aspect_ratio_class_image_2 = 'a-img__ratio--' | append: section.settings.image_ratio_2
  assign video_aspect_ratio_class = 'a-img__ratio--' | append: section.settings.video_ratio
  assign placeholder_media_classes = 'a-img__ratio--' | append: section.settings.image_ratio | append: ' a-placeholder-media'

  assign video_autoplay = false
  assign video_controls = true
  if section.settings.video_autoplay
    assign video_autoplay = true
    assign video_controls = false
  endif

  assign display_mode = section.settings.display_mode
  if display_mode == 'inside-container'
    assign container_fit = 'o-section__constrict'
  elsif display_mode == 'media-outside-container'
    assign container_fit = 'o-mwt__inner--media-outside-container'
  else
    assign container_fit = 'o-mwt__inner--fw'
  endif

  assign contains_2_images = false

  unless section.settings.video and section.settings.video_yt_url != blank
    if section.settings.image_2
      assign contains_2_images = true
    endif
  endunless

  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif

  assign media_width = section.settings.media_width
  assign content_top_position = section.settings.content_top_position

  if content_top_position == 0
    assign content_top_position = '3rem'
  else
    assign content_top_position = section.settings.content_top_position | append: '%'
  endif

  assign content_vertical_position = section.settings.content_vertical_position

  if section.settings.image_ratio == 'adaptive' or section.settings.video_ratio == 'adaptive'
    assign content_vertical_position = 'stretch'
  endif

  assign has_custom_title_position = false

  if section.settings.content_vertical_position == 'stretch'
    assign has_custom_title_position = true
  endif

  assign has_tabs = false
  for block in section.blocks
    if block.type == 'tab'
      assign has_tabs = true
    endif
  endfor
-%}

{%- capture custom_title -%}
  {%- liquid
    if has_custom_title_position
      for block in section.blocks
        capture block_styles
          render '_styles-blocks', block: block
        endcapture
        case block.type
          when 'caption'
            render 'block-caption', block: block, block_styles: block_styles, block_class: 'o-rich-text__caption', override_content: block.settings.title, base_tag: 'div'
          when 'heading'
            render 'block-heading', block: block, block_styles: block_styles, block_class: 'o-rich-text__heading'
        endcase
      endfor
    endif
  -%}
{%- endcapture -%}
{%- capture blocks -%}
  {%- liquid
    for block in section.blocks
      capture block_styles
        render '_styles-blocks', block: block
      endcapture
      case block.type
        when 'caption'
          unless has_custom_title_position
            render 'block-caption', block: block, block_styles: block_styles, block_class: 'o-rich-text__caption', override_content: block.settings.title, base_tag: 'div'
          endunless
        when 'heading'
          unless has_custom_title_position
            render 'block-heading', block: block, block_styles: block_styles, block_class: 'o-rich-text__heading'
          endunless
        when 'paragraph'
          render  'block-text', block: block, block_styles: block_styles, block_class: 'o-rich-text__paragraph'
        when 'button'
          if block.settings.btn_label != blank
            render 'block-button', block: block, block_styles: block_styles, block_class: 'o-rich-text__button'
          endif
        when 'tab'
          render 'product-block-tab', block: block, block_styles: block_styles
      endcase
    endfor
  -%}
{%- endcapture -%}

<div
  class="o-mwt o-section u-color--{{ color_scheme }}"
  style="--content-width:{{ 100 | minus: media_width }}%; --media-width:{{ media_width }}%; --content-top-position: {{ content_top_position }};"
  {% if section.settings.invert_navigation_color %}
    data-invert-navigation
  {% endif %}
  {% if section.settings.section_id != blank %}
    id="{{ section.settings.section_id | handleize }}"
  {% endif %}
>
  {%- render 'section-bg-image', section: section -%}

  <div class="o-mwt__inner {{ container_fit }}">
    <div class="grid grid--{{ content_vertical_position }}-v grid--no-wrap-md">
      <div class="grid__col-12 grid__col-md-6 o-mwt__media-position--{{ media_position }} {% if contains_2_images %}o-mwt__media-two-images{% endif %}">
        {% if section.settings.video %}
          <div class="o-mwt__video a-video {% if settings.enable_animation %}js-animation a-animation a-animation--fade-up{% endif %}">
            {{
              section.settings.video
              | video_tag:
                controls: video_controls,
                autoplay: video_autoplay,
                loop: video_autoplay,
                class: video_aspect_ratio_class,
                image_size: '800x'
            }}
            {% unless video_autoplay %}
              <div class="a-video__overlay">
                <button class="a-video__play-button" tabindex="0" aria-label="{{ "accessibility.play" | t }}">
                  {%- render 'icon-play' -%}
                </button>
              </div>
            {% endunless %}
          </div>
        {% elsif section.settings.video_yt_url != blank %}
          <div class="a-video__video-url {% if settings.enable_animation %}js-animation a-animation a-animation--fade-up{% endif %}">
            {%- if section.settings.video_yt_url.type == 'youtube' -%}
              <iframe
                src="https://www.youtube.com/embed/{{ section.settings.video_yt_url.id }}?enablejsapi=1"
                allow="autoplay; encrypted-media"
                allowfullscreen
                title="{{ section.settings.description | escape }}"
              ></iframe>
            {%- elsif section.settings.video_yt_url.type == 'vimeo' -%}
              <iframe
                src="https://player.vimeo.com/video/{{ section.settings.video_yt_url.id }}"
                allow="autoplay; encrypted-media"
                allowfullscreen
                title="{{ section.settings.description | escape }}"
              ></iframe>
            {%- endif -%}
          </div>
        {% else %}
          {% if section.settings.image %}
            {%- assign widths = '165, 360, 535, 750, 1070, 1500' -%}
            {%- capture sizes -%}
              (min-width: 750px) calc((100vw) / 2), calc((100vw) / 2)
            {%- endcapture -%}
            <div class="o-mwt__image {% if settings.enable_animation %}js-animation a-animation a-animation--fade-up{% endif %}">
              {{
                section.settings.image
                | image_url: width: 1500
                | image_tag:
                  class: aspect_ratio_class,
                  loading: 'lazy',
                  sizes: sizes,
                  widths: widths,
                  fetchpriority: fetch_priority
              }}
            </div>
          {% else %}
            <div class="o-mwt__image {% if settings.enable_animation %}js-animation a-animation a-animation--fade-up{% endif %}">
              {{ 'image' | placeholder_svg_tag: placeholder_media_classes }}
            </div>
          {% endif %}
          {% if section.settings.image_2 %}
            <div class="o-mwt__image--small {% unless section.settings.show_image_2_on_mobile %}a-hide--mobile{% endunless %}">
              <div class="{% if settings.enable_animation %}js-animation a-animation a-animation--fade-up{% endif %}">
                {{
                  section.settings.image_2
                  | image_url: width: 600
                  | image_tag:
                    class: aspect_ratio_class_image_2,
                    loading: 'lazy',
                    sizes: sizes,
                    widths: widths,
                    fetchpriority: fetch_priority
                }}
              </div>
            </div>
          {% endif %}
        {% endif %}
      </div>
      <div class="grid__col-12 grid__col-md-6 o-mwt__content-position--{{ content_position }} ">
        <div class="o-mwt__content u-text-{{ section.settings.content_alignment }}">
          {%- if has_custom_title_position -%}
            <div class="o-mwt__custom-title">
              {{ custom_title }}
            </div>
          {%- endif -%}
          <div class="o-mwt__blocks">
            {{ blocks }}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{%- if has_tabs -%}
  <script src="{{ 'accordion-script.min.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

