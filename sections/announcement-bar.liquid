{{ 'announcement-bar-style.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign color_scheme = section.settings.color_scheme

  assign display_mode = section.settings.display_mode
  assign is_allowed_to_show = true

  if request.page_type == 'index' and section.settings.hide_homepage == true
    assign is_allowed_to_show = false
  endif

  if request.page_type != 'index' and section.settings.show_only_on_homepage == true
    assign is_allowed_to_show = false
  endif

  assign is_slider = false

  if section.blocks.size > 1 and display_mode == 'slider'
    assign is_slider = true
  endif
-%}

{%- capture slider_options -%}
  {
    "direction": "vertical",
    "slidesPerView": 1,
    "speed": 600,
    "loop": true,
    "autoplay": {
      "delay": 5000,
      "disableOnInteraction": false
    }
  }
{%- endcapture -%}

{%- style -%}
  :root {
    {%- if is_allowed_to_show -%}
    --announcement-height: 4rem;
    {%- endif -%}
  }
{%- endstyle -%}

{%- if is_allowed_to_show -%}
  <div
    class="o-announcement-bar o-announcement-bar--{{ display_mode }} u-color--{{ color_scheme }} o-section {% if is_slider %}swiper{% endif %} js-announcement-bar"
    data-top="none"
    data-bottom="none"
  >
    <div class="o-announcement-bar__inner o-section__constrict {% if is_slider %}swiper-wrapper{% endif %}">
      {%- liquid
        case display_mode
          when 'slider'
            for block in section.blocks
              render 'announcement-bar-item', block: block, is_slider: is_slider
            endfor
          when 'static'
            echo '<div class="o-announcement-bar__text-wrapper">'
            for block in section.blocks
              render 'announcement-bar-item', block: block, is_slider: is_slider
            endfor
            echo '</div>'
          when 'marquee'
            echo '<div class="o-announcement-bar__text-wrapper">'
            for i in (1..20)
              for block in section.blocks
                render 'announcement-bar-item', block: block, is_slider: is_slider
              endfor
            endfor
            echo '</div>'
        endcase
      -%}
    </div>
  </div>
  {%- if is_slider -%}
    <script type="application/json" data-swiper>
      {{ slider_options | strip_newlines | remove: " " }}
    </script>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "t:announcement_bar.name",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.headers.section.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:announcement_bar.settings.color_scheme.label",
      "default": "scheme-3"
    },
    {
      "type": "select",
      "id": "display_mode",
      "label": "t:announcement_bar.settings.display_mode.label",
      "options": [
        {
          "value": "slider",
          "label": "t:announcement_bar.settings.display_mode.options.slider.label"
        },
        {
          "value": "static",
          "label": "t:announcement_bar.settings.display_mode.options.static.label"
        },
        {
          "value": "marquee",
          "label": "t:announcement_bar.settings.display_mode.options.marquee.label"
        }
      ],
      "default": "slider"
    },
    {
      "type": "checkbox",
      "id": "show_only_on_homepage",
      "label": "t:announcement_bar.settings.show_only_on_homepage.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_homepage",
      "label": "t:announcement_bar.settings.hide_homepage.label",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "t:announcement_bar.blocks.announcement.announcement.name",
      "settings": [
        {
          "type": "header",
          "content": "t:announcement_bar.blocks.announcement.announcement.settings.header.content.content"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:announcement_bar.blocks.announcement.announcement.settings.title.label",
          "info": "t:announcement_bar.blocks.announcement.announcement.settings.title.info",
          "default": "t:announcement_bar.blocks.announcement.announcement.settings.title.default"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:announcement_bar.blocks.announcement.announcement.settings.link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:announcement_bar.presets.announcement_bar.name",
      "blocks": [
        {
          "type": "announcement"
        }
      ]
    }
  ]
}
{% endschema %}
