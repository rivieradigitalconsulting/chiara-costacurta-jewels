{% doc %}
  @prompt
    ho Bisogno di un elemento banner, di cui posso scegliere la dimensione desktop e mobile. Quindi per ogni device: altezza e larghezza ( se tutto schermo o quanto margine ai lati).
    Può essere compilata con immagine o video,con media diversi per dispositivi. Se collego i campi a un metafield e il Metafield è vuoto, il banner si deve nascondere
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% liquid
  assign desktop_image = block.settings.desktop_image
  assign mobile_image = block.settings.mobile_image
  assign desktop_video = block.settings.desktop_video
  assign mobile_video = block.settings.mobile_video

  assign has_desktop_media = false
  assign has_mobile_media = false

  if desktop_image != blank or desktop_video != blank
    assign has_desktop_media = true
  endif

  if mobile_image != blank or mobile_video != blank
    assign has_mobile_media = true
  endif

  assign should_hide = false
  if has_desktop_media == false and has_mobile_media == false
    assign should_hide = true
  endif
%}

{% unless should_hide %}
  {% style %}
    .ai-banner-{{ ai_gen_id }} {
      display: block;
      width: 100%;
      position: relative;
      overflow: hidden;
    }

    .ai-banner-wrapper-{{ ai_gen_id }} {
      width: 100%;
      max-width: {{ block.settings.desktop_max_width }}%;
      margin: 0 auto;
      position: relative;
    }

    .ai-banner-media-container-{{ ai_gen_id }} {
      position: relative;
      width: 100%;
      height: {{ block.settings.desktop_height }}px;
      overflow: hidden;
      border-radius: {{ block.settings.border_radius }}px;
    }

    .ai-banner-media-{{ ai_gen_id }} {
      width: 100%;
      height: 100%;
      object-fit: {{ block.settings.desktop_object_fit }};
      display: block;
    }

    .ai-banner-mobile-media-{{ ai_gen_id }} {
      display: none;
    }

    @media screen and (max-width: 749px) {
      .ai-banner-wrapper-{{ ai_gen_id }} {
        max-width: {{ block.settings.mobile_max_width }}%;
      }

      .ai-banner-media-container-{{ ai_gen_id }} {
        height: {{ block.settings.mobile_height }}px;
      }

      .ai-banner-media-{{ ai_gen_id }} {
        object-fit: {{ block.settings.mobile_object_fit }};
      }

      .ai-banner-desktop-media-{{ ai_gen_id }} {
        display: none;
      }

      .ai-banner-mobile-media-{{ ai_gen_id }} {
        display: block;
      }
    }
  {% endstyle %}

  <div class="ai-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
    <div class="ai-banner-wrapper-{{ ai_gen_id }}">
      <div class="ai-banner-media-container-{{ ai_gen_id }}">
        {% if has_desktop_media %}
          <div class="ai-banner-desktop-media-{{ ai_gen_id }}">
            {% if desktop_video != blank %}
              {{
                desktop_video
                | video_tag:
                  autoplay: true,
                  loop: true,
                  muted: true,
                  controls: false,
                  class: 'ai-banner-media-' | append: ai_gen_id
              }}
            {% elsif desktop_image != blank %}
              <img
                src="{{ desktop_image | image_url: width: 2000 }}"
                alt="{{ desktop_image.alt | escape }}"
                loading="lazy"
                width="{{ desktop_image.width }}"
                height="{{ desktop_image.height }}"
                class="ai-banner-media-{{ ai_gen_id }}"
              >
            {% endif %}
          </div>
        {% endif %}

        {% if has_mobile_media %}
          <div class="ai-banner-mobile-media-{{ ai_gen_id }}">
            {% if mobile_video != blank %}
              {{
                mobile_video
                | video_tag:
                  autoplay: true,
                  loop: true,
                  muted: true,
                  controls: false,
                  class: 'ai-banner-media-' | append: ai_gen_id
              }}
            {% elsif mobile_image != blank %}
              <img
                src="{{ mobile_image | image_url: width: 1000 }}"
                alt="{{ mobile_image.alt | escape }}"
                loading="lazy"
                width="{{ mobile_image.width }}"
                height="{{ mobile_image.height }}"
                class="ai-banner-media-{{ ai_gen_id }}"
              >
            {% endif %}
          </div>
        {% elsif has_desktop_media %}
          <div class="ai-banner-mobile-media-{{ ai_gen_id }}">
            {% if desktop_video != blank %}
              {{
                desktop_video
                | video_tag:
                  autoplay: true,
                  loop: true,
                  muted: true,
                  controls: false,
                  class: 'ai-banner-media-' | append: ai_gen_id
              }}
            {% elsif desktop_image != blank %}
              <img
                src="{{ desktop_image | image_url: width: 1000 }}"
                alt="{{ desktop_image.alt | escape }}"
                loading="lazy"
                width="{{ desktop_image.width }}"
                height="{{ desktop_image.height }}"
                class="ai-banner-media-{{ ai_gen_id }}"
              >
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
{% endunless %}

{% schema %}
{
  "name": "Banner media",
  "settings": [
    {
      "type": "header",
      "content": "Desktop"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Image"
    },
    {
      "type": "video",
      "id": "desktop_video",
      "label": "Video"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "Height",
      "min": 200,
      "max": 1000,
      "step": 50,
      "unit": "px",
      "default": 500
    },
    {
      "type": "range",
      "id": "desktop_max_width",
      "label": "Width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "desktop_object_fit",
      "label": "Image fit",
      "options": [
        {
          "value": "cover",
          "label": "Cover"
        },
        {
          "value": "contain",
          "label": "Contain"
        },
        {
          "value": "fill",
          "label": "Fill"
        }
      ],
      "default": "cover"
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Image"
    },
    {
      "type": "video",
      "id": "mobile_video",
      "label": "Video"
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Height",
      "min": 200,
      "max": 800,
      "step": 50,
      "unit": "px",
      "default": 400
    },
    {
      "type": "range",
      "id": "mobile_max_width",
      "label": "Width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "mobile_object_fit",
      "label": "Image fit",
      "options": [
        {
          "value": "cover",
          "label": "Cover"
        },
        {
          "value": "contain",
          "label": "Contain"
        },
        {
          "value": "fill",
          "label": "Fill"
        }
      ],
      "default": "cover"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Banner media"
    }
  ]
}
{% endschema %}
