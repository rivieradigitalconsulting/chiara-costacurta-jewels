{% doc %}
  @prompt
    Generami un blocco di testo, che collego a un Metafield. Se il blocco è vuoto e non valorizzato, allora il blocco non appare. Possibilità di inserire un rich text. su mobile la larghezza si adatta al contenuto di pagina, con i bordi della pagina, su desktop decido io quanto larga la colonna di testo deve essere. Per ogni dispositivo devo poter scegliere margin top e bottom 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-metafield-text-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding-left: 20px;
    padding-right: 20px;
    margin-top: {{ block.settings.margin_top_mobile }}px;
    margin-bottom: {{ block.settings.margin_bottom_mobile }}px;
  }

  .ai-metafield-text-content-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.font_size }}px;
    line-height: 1.5;
  }

  .ai-metafield-text-content-{{ ai_gen_id }} p {
    margin: 0 0 1em 0;
  }

  .ai-metafield-text-content-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  @media screen and (min-width: 750px) {
    .ai-metafield-text-{{ ai_gen_id }} {
      width: {{ block.settings.desktop_width_percent }}%;
      margin-left: auto;
      margin-right: auto;
      margin-top: {{ block.settings.margin_top_desktop }}px;
      margin-bottom: {{ block.settings.margin_bottom_desktop }}px;
    }
  }
{% endstyle %}

{% liquid
  assign metafield_value = ''
  
  if block.settings.metafield_namespace != blank and block.settings.metafield_key != blank
    case block.settings.metafield_source
      when 'product'
        assign metafield_value = product.metafields[block.settings.metafield_namespace][block.settings.metafield_key]
      when 'variant'
        assign metafield_value = product.selected_or_first_available_variant.metafields[block.settings.metafield_namespace][block.settings.metafield_key]
      when 'collection'
        assign metafield_value = collection.metafields[block.settings.metafield_namespace][block.settings.metafield_key]
      when 'page'
        assign metafield_value = page.metafields[block.settings.metafield_namespace][block.settings.metafield_key]
      when 'article'
        assign metafield_value = article.metafields[block.settings.metafield_namespace][block.settings.metafield_key]
      when 'blog'
        assign metafield_value = blog.metafields[block.settings.metafield_namespace][block.settings.metafield_key]
    endcase
  endif
%}

{% if metafield_value != blank %}
  <div class="ai-metafield-text-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
    <div class="ai-metafield-text-content-{{ ai_gen_id }}">
      {{ metafield_value }}
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Metafield text",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Metafield"
    },
    {
      "type": "select",
      "id": "metafield_source",
      "label": "Metafield source",
      "options": [
        {
          "value": "product",
          "label": "Product"
        },
        {
          "value": "variant",
          "label": "Variant"
        },
        {
          "value": "collection",
          "label": "Collection"
        },
        {
          "value": "page",
          "label": "Page"
        },
        {
          "value": "article",
          "label": "Article"
        },
        {
          "value": "blog",
          "label": "Blog"
        }
      ],
      "default": "product"
    },
    {
      "type": "text",
      "id": "metafield_namespace",
      "label": "Metafield namespace",
      "info": "Example: custom"
    },
    {
      "type": "text",
      "id": "metafield_key",
      "label": "Metafield key",
      "info": "Example: description"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#1d1d1d"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Desktop layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "margin_top_desktop",
      "label": "Margin top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "margin_bottom_desktop",
      "label": "Margin bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Mobile layout"
    },
    {
      "type": "range",
      "id": "margin_top_mobile",
      "label": "Margin top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "margin_bottom_mobile",
      "label": "Margin bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "Metafield text"
    }
  ]
}
{% endschema %}
