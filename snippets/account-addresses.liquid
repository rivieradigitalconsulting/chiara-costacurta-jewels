{{ 'account-addresses-style.css' | asset_url | stylesheet_tag }}
<script src="{{ 'account-addresses-script.min.js' | asset_url }}" defer></script>

{%- paginate customer.addresses by 4 -%}
  <div class="m-account-addresses grid" data-customer-addresses>
    <div class="grid__col-12 grid__col-lg-8">
      <ul role="list" class="grid u-unstyled-list m-account-addresses__inner">
        {%- for address in customer.addresses -%}
          <li
            data-address
            class="grid__col-12 grid__col-sm-5 m-account-addresses__address {% if address != customer.default_address %}not-default{% endif %}"
          >
            {%- if address == customer.default_address -%}
              <span>{{ 'customer.addresses.default' | t }}</span>
            {%- endif -%}
            {{ address | format_address }}
            <button
              type="button"
              class="a-link"
              id="EditFormButton_{{ address.id }}"
              aria-label="{{ 'customer.addresses.edit_address' | t }} {{ forloop.index }}"
              aria-controls="EditAddress_{{ address.id }}"
              aria-expanded="false"
              data-address-id="{{ address.id }}"
            >
              {{ 'customer.addresses.edit' | t }}
            </button>
            <button
              type="button"
              class="a-link"
              aria-label="{{ 'customer.addresses.delete' | t }} {{ forloop.index }}"
              data-target="{{ address.url }}"
              data-confirm-message="{{ 'customer.addresses.delete_confirm' | t }}"
            >
              {{ 'customer.addresses.delete' | t }}
            </button>
            <div id="EditAddress_{{ address.id }}">
              {%- form 'customer_address', address -%}
                <div class="a-input">
                  <label class="a-input__label" for="AddressFirstName_{{ form.id }}">
                    {{- 'customer.addresses.first_name' | t -}}
                  </label>
                  <input
                    type="text"
                    id="AddressFirstName_{{ form.id }}"
                    name="address[first_name]"
                    value="{{ form.first_name }}"
                    autocomplete="given-name"
                    placeholder="{{ 'customer.addresses.first_name' | t }}"
                    class="a-input__field"
                  >
                </div>
                <div class="a-input">
                  <label class="a-input__label" for="AddressLastName_{{ form.id }}">
                    {{- 'customer.addresses.last_name' | t -}}
                  </label>
                  <input
                    type="text"
                    id="AddressLastName_{{ form.id }}"
                    name="address[last_name]"
                    value="{{ form.last_name }}"
                    autocomplete="family-name"
                    placeholder="{{ 'customer.addresses.last_name' | t }}"
                    class="a-input__field"
                  >
                </div>
                <div class="a-input">
                  <label class="a-input__label" for="AddressCompany_{{ form.id }}">
                    {{- 'customer.addresses.company' | t -}}
                  </label>
                  <input
                    type="text"
                    id="AddressCompany_{{ form.id }}"
                    name="address[company]"
                    value="{{ form.company }}"
                    autocomplete="organization"
                    placeholder="{{ 'customer.addresses.company' | t }}"
                    class="a-input__field"
                  >
                </div>
                <div class="a-input">
                  <label class="a-input__label" for="AddressAddress1_{{ form.id }}">
                    {{- 'customer.addresses.address1' | t -}}
                  </label>
                  <input
                    type="text"
                    id="AddressAddress1_{{ form.id }}"
                    name="address[address1]"
                    value="{{ form.address1 }}"
                    autocomplete="address-line1"
                    placeholder="{{ 'customer.addresses.address1' | t }}"
                    class="a-input__field"
                  >
                </div>
                <div class="a-input">
                  <label class="a-input__label" for="AddressAddress2_{{ form.id }}">
                    {{- 'customer.addresses.address2' | t -}}
                  </label>
                  <input
                    type="text"
                    id="AddressAddress2_{{ form.id }}"
                    name="address[address2]"
                    value="{{ form.address2 }}"
                    autocomplete="address-line2"
                    placeholder="{{ 'customer.addresses.address2' | t }}"
                    class="a-input__field"
                  >
                </div>
                <div class="a-input">
                  <label class="a-input__label" for="AddressCity_{{ form.id }}">
                    {{- 'customer.addresses.city' | t -}}
                  </label>
                  <input
                    type="text"
                    id="AddressCity_{{ form.id }}"
                    name="address[city]"
                    value="{{ form.city }}"
                    autocomplete="address-level2"
                    placeholder="{{ 'customer.addresses.city' | t }}"
                    class="a-input__field"
                  >
                </div>
                <div class="a-select">
                  <label for="AddressCountry_{{ form.id }}" class="a-input__label">
                    {{ 'customer.addresses.country' | t }}
                  </label>
                  <select
                    id="AddressCountry_{{ form.id }}"
                    name="address[country]"
                    data-address-country-select
                    data-default="{{ form.country }}"
                    data-form-id="{{ form.id }}"
                    autocomplete="country"
                    class="a-select__field custom-select"
                  >
                    {{ country_option_tags }}
                  </select>
                </div>
                <div id="AddressProvinceContainer_{{ form.id }}" class="a-select" style="display:none;">
                  <label for="AddressProvince_{{ form.id }}" class="a-input__label">
                    {{ 'customer.addresses.province' | t }}
                  </label>
                  <select
                    id="AddressProvince_{{ form.id }}"
                    name="address[province]"
                    data-default="{{ form.province }}"
                    autocomplete="address-level1"
                    class="a-select__field custom-select"
                  ></select>
                </div>
                <div class="a-input">
                  <label class="a-input__label" for="AddressZip_{{ form.id }}">
                    {{- 'customer.addresses.zip' | t -}}
                  </label>
                  <input
                    type="text"
                    id="AddressZip_{{ form.id }}"
                    name="address[zip]"
                    value="{{ form.zip }}"
                    autocapitalize="characters"
                    autocomplete="postal-code"
                    placeholder="{{ 'customer.addresses.zip' | t }}"
                    class="a-input__field"
                  >
                </div>
                <div class="a-input">
                  <label class="a-input__label" for="AddressPhone_{{ form.id }}">
                    {{- 'customer.addresses.phone' | t -}}
                  </label>
                  <input
                    type="tel"
                    id="AddressPhone_{{ form.id }}"
                    name="address[phone]"
                    value="{{ form.phone }}"
                    autocomplete="tel"
                    placeholder="{{ 'customer.addresses.phone' | t }}"
                    class="a-input__field"
                  >
                </div>
                <div class="a-checkbox">
                  {{ form.set_as_default_checkbox }}
                  <label for="address_default_address_{{ form.id }}" class="a-checkbox__label">
                    <p>{{ 'customer.addresses.set_default' | t }}</p>
                  </label>
                </div>
                <div>
                  <button class="a-link" aria-label="{{ "customer.addresses.update" | t }}">
                    {{ 'customer.addresses.update' | t }}
                  </button>
                  <button type="reset" class="a-link" aria-label="{{ "customer.addresses.cancel" | t }}">
                    {{ 'customer.addresses.cancel' | t }}
                  </button>
                </div>
              {%- endform -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>

      {%- if paginate.pages > 1 -%}
        {% render 'pagination', paginate: paginate %}
      {%- endif -%}
    </div>

    <div class="grid__col-12 grid__col-lg-4" data-address>
      <h2 class="h4 m-account-addresses__heading">{{ 'customer.addresses.new_address' | t }}</h2>
      <button
        type="button"
        class="{% if section.settings.btn_style == "line" %} a-link {% else %} a-btn a-btn--{{ section.settings.btn_style }}{% endif %}"
        aria-expanded="false"
        aria-controls="AddAddress"
        aria-label="{{ "customer.addresses.add_new" | t }}"
      >
        {{ 'customer.addresses.add_new' | t }}
      </button>
      <div id="AddAddress">
        {%- form 'customer_address', customer.new_address, aria-labelledBy: 'AddressNewHeading' -%}
          <div class="a-input">
            <label for="AddressFirstNameNew" class="a-input__label">{{ 'customer.addresses.first_name' | t }}</label>
            <input
              type="text"
              id="AddressFirstNameNew"
              name="address[first_name]"
              value="{{ form.first_name }}"
              autocomplete="given-name"
              placeholder="{{ 'customer.addresses.first_name' | t }}"
              class="a-input__field"
            >
          </div>
          <div class="a-input">
            <label for="AddressLastNameNew" class="a-input__label">{{ 'customer.addresses.last_name' | t }}</label>
            <input
              type="text"
              id="AddressLastNameNew"
              name="address[last_name]"
              value="{{ form.last_name }}"
              autocomplete="family-name"
              placeholder="{{ 'customer.addresses.last_name' | t }}"
              class="a-input__field"
            >
          </div>
          <div class="a-input">
            <label for="AddressCompanyNew" class="a-input__label">{{ 'customer.addresses.company' | t }}</label>
            <input
              type="text"
              id="AddressCompanyNew"
              name="address[company]"
              value="{{ form.company }}"
              autocomplete="organization"
              placeholder="{{ 'customer.addresses.company' | t }}"
              class="a-input__field"
            >
          </div>
          <div class="a-input">
            <label for="AddressAddress1New" class="a-input__label">{{ 'customer.addresses.address1' | t }}</label>
            <input
              type="text"
              id="AddressAddress1New"
              name="address[address1]"
              value="{{ form.address1 }}"
              autocomplete="address-line1"
              placeholder="{{ 'customer.addresses.address1' | t }}"
              class="a-input__field"
            >
          </div>
          <div class="a-input">
            <label for="AddressAddress2New" class="a-input__label">{{ 'customer.addresses.address2' | t }}</label>
            <input
              type="text"
              id="AddressAddress2New"
              name="address[address2]"
              value="{{ form.address2 }}"
              autocomplete="address-line2"
              placeholder="{{ 'customer.addresses.address2' | t }}"
              class="a-input__field"
            >
          </div>
          <div class="a-input">
            <label for="AddressCityNew" class="a-input__label">{{ 'customer.addresses.city' | t }}</label>
            <input
              type="text"
              id="AddressCityNew"
              name="address[city]"
              value="{{ form.city }}"
              autocomplete="address-level2"
              placeholder="{{ 'customer.addresses.city' | t }}"
              class="a-input__field"
            >
          </div>
          <div class="a-select">
            <label class="a-input__label" for="AddressCountryNew">{{ 'customer.addresses.country' | t }}</label>
            <select
              id="AddressCountryNew"
              name="address[country]"
              data-default="{{ form.country }}"
              class="a-select__field custom-select"
            >
              {{ country_option_tags }}
            </select>
          </div>
          <div id="AddressProvinceContainerNew" class="a-input" style="display: none">
            <label for="AddressProvinceNew" class="a-input__label">{{ 'customer.addresses.province' | t }}</label>
            <select
              id="AddressProvinceNew"
              name="address[province]"
              data-default="{{ form.province }}"
              autocomplete="address-level1"
              class="a-select__field custom-select"
            ></select>
          </div>
          <div class="a-input">
            <label for="AddressZipNew" class="a-input__label">{{ 'customer.addresses.zip' | t }}</label>
            <input
              type="text"
              id="AddressZipNew"
              name="address[zip]"
              value="{{ form.zip }}"
              autocapitalize="characters"
              autocomplete="postal-code"
              placeholder="{{ 'customer.addresses.zip' | t }}"
              class="a-input__field"
            >
          </div>
          <div class="a-input">
            <label for="AddressPhoneNew" class="a-input__label">{{ 'customer.addresses.phone' | t }}</label>
            <input
              type="tel"
              id="AddressPhoneNew"
              name="address[phone]"
              value="{{ form.phone }}"
              autocomplete="tel"
              placeholder="{{ 'customer.addresses.phone' | t }}"
              class="a-input__field"
            >
          </div>
          <div class="a-checkbox">
            {{ form.set_as_default_checkbox }}
            <label for="address_default_address_new" class="a-checkbox__label">
              <p>{{ 'customer.addresses.set_default' | t }}</p>
            </label>
          </div>
          <div>
            <button class="a-link" aria-label="{{ "customer.addresses.add" | t }}">
              {{ 'customer.addresses.add' | t }}
            </button>
            <button type="reset" class="a-link" aria-label="{{ "customer.addresses.cancel" | t }}">
              {{ 'customer.addresses.cancel' | t }}
            </button>
          </div>
        {%- endform -%}
      </div>
    </div>
  </div>
{%- endpaginate -%}

<script>
  window.onload = () => {
    typeof CustomerAddresses !== 'undefined' && new CustomerAddresses()
  }
</script>
