{%- liquid
  assign list_product = product

  assign section_id = section_id
  assign color_scheme = color_scheme

  assign combined_section_id = section_id | append: list_product.id
  assign product_form_id = 'product-form-' | append: section_id | append: list_product.id

  assign extra_variant_class = extra_variant_class
  assign has_variants = false

  if list_product.variants.size > 1
    assign has_variants = true
  endif

  assign is_preorder = false
  for tag in list_product.tags
    if tag contains 'preorder'
      assign is_preorder = true
    endif
  endfor
-%}

<div class="m-product-list">
  <div class="m-product-list__image">
    {%- if list_product.featured_media -%}
      {{ list_product.featured_media | image_url: width: 800 | image_tag: loading: 'lazy' }}
    {%- else -%}
      {{ 'image' | placeholder_svg_tag: 'a-placeholder-media' }}
    {%- endif -%}
  </div>

  <div class="m-product-list__content">
    <h3 class="m-product-list__title product-title">
      <a href="{{ list_product.url }}">
        {{ list_product.title }}
      </a>
    </h3>
    <div class="m-product-list__price" id="price-{{ combined_section_id }}">
      {%- render 'price', product: list_product, use_variant: true, price_class: 'm-price--sm' -%}
    </div>

    {%- if has_variants -%}
      <div class="m-product-form__buttons">
        <button
          name="options"
          class="m-product-form__options u-unstyled-btn a-link js-image-hotspot-optionsbar-toggle"
          aria-label="{{ 'products.product.choose_options' | t }}"
        >
          <span class="m-product-form__submit-text">
            {{ 'products.product.choose_options' | t }}
          </span>
          <span class="m-product-form__loader hide">
            {%- render 'icon-loader', loader_classes: 'a-loader--light' -%}
          </span>
        </button>
      </div>

      <div class="m-image-hotspot-optionsbar js-image-hotspot-optionsbar">
        <div class="m-image-hotspot-optionsbar__content u-color--{{ color_scheme }}">
          <div class="m-image-hotspot-optionsbar__header grid grid--no-wrap grid--center-v">
            <button
              class="u-unstyled-btn m-image-hotspot-optionsbar__close js-image-hotspot-optionsbar-close"
              tabindex="-1"
              aria-label="{{ "accessibility.close" | t }}"
            >
              {%- render 'icon-chevron-left' -%}
            </button>

            <div class="m-image-hotspot-optionsbar__heading">{{ 'products.product.select_options' | t }}</div>
          </div>
          <div
            class="m-image-hotspot-optionsbar__variants m-variants js-variants {{ extra_variant_class }}"
            data-section="{{ combined_section_id }}"
            data-url="/products/{{ list_product.handle }}"
            data-type="radio"
            data-update-url="false"
            {{ block.shopify_attributes }}
          >
            {%- for option in product.options_with_values -%}
              <fieldset class="m-variants__fieldset">
                <legend class="m-variants__legend a-input__label">{{ option.name }}</legend>
                {%- render 'product-variant-options',
                  product: list_product,
                  option: option,
                  display_mode: 'button',
                  product_form_id: product_form_id,
                  section_id: combined_section_id
                -%}
              </fieldset>
            {%- endfor -%}
            <script type="application/json">
              {{ list_product.variants | json }}
            </script>
            <div
              class="m-variants__buy-buttons a-spacing-content"
              style="{{ block_styles | strip_newlines | remove: ' ' }}"
            >
              {%- if list_product != blank -%}
                {%- render 'product-block-buy-buttons',
                  section: section,
                  product: list_product,
                  block: block,
                  product_form_id: product_form_id,
                  is_preorder: is_preorder
                -%}
              {%- else -%}
                <a
                  class="a-spacing-content m-product-form__submit u-text-center{% if block.settings.btn_style == "line" %} a-link {% else %} a-btn a-btn--{{ block.settings.btn_style }}{% endif %} {% if block.settings.btn_icon %}a-btn--has-icon{% endif %} disabled"
                  style="{{ block_styles | strip_newlines | remove: ' ' }}"
                  disabled
                >
                  {%- if block.settings.btn_label != blank -%}
                    {{- block.settings.btn_label -}}
                  {%- else %}
                    {{ 'products.product.sold_out' | t }}
                  {%- endif %}
                  {% if block.settings.btn_icon %}
                    {%- render 'icon-arrow-right' -%}
                  {%- endif %}
                </a>
              {%- endif -%}
            </div>
          </div>
        </div>
        <span class="u-backdrop js-image-hotspot-optionsbar-underlay"></span>
      </div>
    {%- else -%}
      <div class="js-product-form no-js-hidden">
        {%- form 'product',
          list_product,
          id: product_form_id,
          class: 'form form-quick-add',
          novalidate: 'novalidate',
          data-type: 'add-to-cart-form'
        -%}
          <input type="hidden" name="id" value="{{ list_product.selected_or_first_available_variant.id }}">

          <div class="m-product-form__buttons">
            <button
              type="submit"
              name="add"
              class="m-product-form__submit u-unstyled-btn a-link js-cart-trigger {% if is_preorder %}is-preorder{% endif %}"
              {% if list_product.selected_or_first_available_variant.available == false %}
                disabled
              {% endif %}
              aria-label="
                {%- if list_product.selected_or_first_available_variant.available -%}
                  {% if is_preorder %}
                    {{ 'products.product.preorder' | t }}
                  {% else %}
                    {{ 'products.product.add_to_cart' | t }}
                  {% endif %}
                {%- else -%}
                  {{ 'products.product.sold_out' | t }}
                {%- endif -%}
              "
            >
              <span class="m-product-form__submit-text">
                {%- if list_product.selected_or_first_available_variant.available -%}
                  {% if is_preorder %}
                    {{ 'products.product.preorder' | t }}
                  {% else %}
                    {{ 'products.product.add_to_cart' | t }}
                  {% endif %}
                {%- else -%}
                  {{ 'products.product.sold_out' | t }}
                {%- endif -%}
              </span>
              <span class="m-product-form__sold-out-message hide">
                {{ 'products.product.sold_out' | t }}
              </span>
              <span class="m-product-form__loader hide">
                {%- render 'icon-loader', loader_classes: 'a-loader--light' -%}
              </span>
            </button>
          </div>
        {%- endform -%}
      </div>
    {%- endif -%}
  </div>
</div>
