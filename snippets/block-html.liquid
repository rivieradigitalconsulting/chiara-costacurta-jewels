{%- liquid
  assign classes = 'a-spacing-content ' | append: block.settings.text_size | append: ' u-text-' | append: block.settings.text_style

  if block_class != blank
    assign classes = classes | append: ' ' | append: block_class
  endif

  if settings.enable_animation and disable_animation != true
    assign classes = classes | append: ' js-animation a-animation a-animation--fade-up'
  endif

  assign html = block.settings.html | default: override_content
-%}
<div
  class="{{ classes }}"
  {% if block_styles %}
    style="{{ block_styles | strip_newlines | remove: ' ' }}"
  {% endif %}
  {{ block.shopify_attributes }}
>
  {{ html }}
</div>
