{%- if block.settings.block_spacing_top_desktop != blank -%}
  --spacing-top-desktop: {{ block.settings.block_spacing_top_desktop }}px;
{%- endif -%}
{%- if block.settings.block_spacing_bottom_desktop != blank -%}
  --spacing-bottom-desktop: {{ block.settings.block_spacing_bottom_desktop }}px;
{%- endif -%}

{%- if block.settings.block_spacing_top_mobile != blank -%}
  --spacing-top-mobile: {{ block.settings.block_spacing_top_mobile }}px;
{%- endif -%}
