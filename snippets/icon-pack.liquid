{%- liquid
  case icon
    when 'account'
      render 'icon-account'
    when 'cart'
      render 'icon-cart'
    when 'checkmark'
      render 'icon-checkmark'
    when 'arrow-right'
      render 'icon-arrow-right'
    when 'arrow-left'
      render 'icon-arrow-left'
    when 'caret'
      render 'icon-caret'
    when 'plus'
      render 'icon-plus'
    when 'chevron-left'
      render 'icon-chevron-left'
    when 'chevron-right'
      render 'icon-chevron-right'
    when 'clipboard'
      render 'icon-clipboard'
    when 'filter'
      render 'icon-filter'
    when 'instagram'
      render 'icon-instagram'
    when 'facebook'
      render 'icon-facebook'
    when 'linkedin'
      render 'icon-linkedin'
    when 'pinterest'
      render 'icon-pinterest'
    when 'snapchat'
      render 'icon-snapchat'
    when 'tiktok'
      render 'icon-tiktok'
    when 'tumblr'
      render 'icon-tumblr'
    when 'vimeo'
      render 'icon-vimeo'
    when 'youtube'
      render 'icon-youtube'
    when 'search'
      render 'icon-search'
    when 'share'
      render 'icon-share'
    when 'shipping'
      render 'icon-shipping'
    when 'subscriptions'
      render 'icon-subscriptions'
  endcase
-%}
