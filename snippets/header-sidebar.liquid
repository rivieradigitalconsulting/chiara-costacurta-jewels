{%- liquid
  assign main_menu = main_menu
  assign color_scheme = color_scheme
-%}

<div class="m-header-sidebar js-sidebar" tabindex="-1">
  <div class="m-header-sidebar__content u-color--{{ color_scheme }} js-sidebar-content">
    <button class="m-header-sidebar__close js-sidebar-close" aria-label="{{ 'accessibility.close' | t }}">
      {%- render 'icon-close' -%}
    </button>
    <div class="m-header-sidebar__main">
      <div class="m-header-sidebar__main-menu">
        <div class="m-header-sidebar__item">
          <div class="m-header-sidebar__item-wrapper m-header-sidebar__menu-heading">
            <div class="body-fs-lg">{{ 'sections.header.menu' | t }}</div>
          </div>
        </div>
        {%- for link in main_menu.links -%}
          <div class="m-header-sidebar__item">
            <div class="m-header-sidebar__item-wrapper {% if link.links != blank %}js-show-panel{% endif %}">
              {%- if link.links != blank -%}
                <button
                  class="m-header-sidebar__link {% if link.current %} m-header-sidebar__link--active{% endif %}"
                  aria-label="{{ link.title }}"
                >
                  <span>{{ link.title }}</span>
                </button>
                <div class="m-header-sidebar__icon-right">
                  {%- render 'icon-chevron-right' -%}
                </div>
              {%- else -%}
                <a
                  href="{{ link.url }}"
                  class="m-header-sidebar__link {% if link.current %} m-header-sidebar__link--active{% endif %}"
                >
                  <span>{{ link.title }}</span>
                </a>
              {%- endif -%}
            </div>
            {%- if link.links != blank -%}
              <div class="m-header-sidebar__panel" data-panel="1">
                <div class="m-header-sidebar__back">
                  <button
                    class="m-header-sidebar__icon-left js-back-to-prev-panel"
                    aria-label="{{ "accessibility.previous" | t }}"
                  >
                    {%- render 'icon-arrow-left' -%}
                  </button>
                  <a
                    href="{{ link.url }}"
                    class="m-header-sidebar__link {% if link.current %} m-header-sidebar__link--active{% endif %}"
                  >
                    <span>{{ link.title }}</span>
                  </a>
                </div>
                {%- for child_link in link.links -%}
                  <div class="m-header-sidebar__item">
                    <div class="m-header-sidebar__item-wrapper {% if child_link.links != blank %}js-show-panel{% endif %}">
                      {%- if child_link.links != blank -%}
                        <button
                          class="m-header-sidebar__link {% if child_link.current %} m-header-sidebar__link--active{% endif %}"
                          aria-label="{{ child_link.title }}"
                        >
                          <span>{{ child_link.title }}</span>
                        </button>
                        <div class="m-header-sidebar__icon-right">
                          {%- render 'icon-chevron-right' -%}
                        </div>
                      {%- else -%}
                        <a
                          href="{{ child_link.url }}"
                          class="m-header-sidebar__link {% if child_link.current %} m-header-sidebar__link--active{% endif %}"
                        >
                          <span>{{ child_link.title }}</span>
                        </a>
                      {%- endif -%}
                    </div>
                    {%- if child_link.links != blank -%}
                      <div class="m-header-sidebar__panel" data-panel="2">
                        <div class="m-header-sidebar__back">
                          <button
                            class="m-header-sidebar__icon-left js-back-to-prev-panel"
                            aria-label="{{ "accessibility.previous" | t}}"
                          >
                            {%- render 'icon-arrow-left' -%}
                          </button>
                          <a
                            href="{{ child_link.url }}"
                            class="m-header-sidebar__link {% if child_link.current %} m-header-sidebar__link--active{% endif %}"
                          >
                            <span>{{ child_link.title }}</span>
                          </a>
                        </div>
                        {%- for grand_child_link in child_link.links -%}
                          <div class="m-header-sidebar__item">
                            <div class="m-header-sidebar__item-wrapper">
                              <a
                                href="{{ grand_child_link.url }}"
                                class="m-header-sidebar__link {% if grand_child_link.current %} m-header-sidebar__link--active{% endif %}"
                              >
                                <span>{{ grand_child_link.title }}</span>
                              </a>
                            </div>
                          </div>
                        {%- endfor -%}

                        {%- render 'navigation-promotions', section: section, link: child_link, sidebar: true -%}

                      </div>
                    {%- endif -%}
                  </div>
                {%- endfor -%}

                {%- render 'navigation-promotions', section: section, link: link, sidebar: true -%}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
    <div class="m-header-sidebar__bottom">
      <div class="m-header-sidebar__secondary-menu">
        <ul class="m-header-sidebar__secondary-menu-list grid u-unstyled-list u-list-inline">
          {%- if shop.customer_accounts_enabled -%}
            <li class="m-header-sidebar__item m-header-sidebar__item-account">
              <a
                href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
                class="m-header-sidebar__link"
              >
                {{ 'sections.header.account' | t }}
              </a>
            </li>
          {%- endif -%}
        </ul>
      </div>
    </div>
  </div>
  <span class="u-backdrop js-sidebar-underlay"></span>
</div>
