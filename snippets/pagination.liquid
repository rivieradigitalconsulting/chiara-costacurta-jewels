{% comment %}
  Renders a set of links for paginated results. Must be used within paginate tags.

  Usage:
  {% paginate results by 2 %}
    {% render 'pagination', paginate: paginate, anchor: '#yourID' %}
  {% endpaginate %}

  Accepts:
  - paginate: {Object}
  - anchor: {String} (optional) This can be added so that on page reload it takes you to wherever you've placed your anchor tag.
{% endcomment %}
<link rel="stylesheet" href="{{ 'pagination-style.css' | asset_url }}" media="print" onload="this.media='all'">

{%- if paginate.parts.size > 0 -%}
  <div class="m-pagination__wrapper">
    <div class="m-pagination">
      <div class="m-pagination__list">
        {%- if paginate.previous -%}
          <a
            href="{{ paginate.previous.url }}{{ anchor }}"
            class="m-pagination__item m-pagination__item--previous m-pagination__arrow"
            aria-label="{{ 'general.pagination.previous' | t }}"
          >
            {% render 'icon-caret' %}
          </a>
        {%- endif -%}
        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}
            <a
              href="{{ part.url }}{{ anchor }}"
              class="m-pagination__item"
              aria-label="{{ 'general.pagination.page' | t: number: part.title }}"
            >
              {{- part.title -}}
            </a>
          {%- else -%}
            {%- if part.title == paginate.current_page -%}
              <a
                role="link"
                aria-disabled="true"
                class="m-pagination__item m-pagination__item--current"
                aria-current="page"
                aria-label="{{ 'general.pagination.page' | t: number: part.title }}"
              >
                {{- part.title -}}
              </a>
            {%- else -%}
              <span class="m-pagination__item">{{ part.title }}</span>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if paginate.next -%}
          <a
            href="{{ paginate.next.url }}{{ anchor }}"
            class="m-pagination__item m-pagination__item--next m-pagination__arrow"
            aria-label="{{ 'general.pagination.next' | t }}"
          >
            {% render 'icon-caret' %}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}
