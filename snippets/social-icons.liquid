{%- liquid
  assign alignment = alignment
-%}

<ul
  class="u-unstyled-list u-list-inline m-list-social {% if alignment != blank %}grid--{{ alignment }}-h{% endif %}"
  role="list"
>
  {%- if settings.social_x_link != blank -%}
    <li class="m-list-social__item">
      <a href="{{ settings.social_x_link }}" class="link m-list-social__link">
        {%- render 'icon-x' -%}
        <span class="visually-hidden">{{ 'general.social.links.x' | t }}</span>
      </a>
    </li>
  {%- endif -%}
  {%- if settings.social_facebook_link != blank -%}
    <li class="m-list-social__item">
      <a href="{{ settings.social_facebook_link }}" class="link m-list-social__link">
        {%- render 'icon-facebook' -%}
        <span class="visually-hidden">{{ 'general.social.links.facebook' | t }}</span>
      </a>
    </li>
  {%- endif -%}
