{%- assign items_in_cart = cart | line_items_for: product | sum: 'quantity' -%}

<div class="m-quick-order-total" id="quick-order-list-total">
  <div class="js-contents">
    <div class="m-quick-order-total__info">
      <div class="m-quick-order-total__buttons-wrapper">
        <div class="m-quick-order-total__buttons">
          <a
            href="{{ routes.cart_url }} "
            class="a-btn a-btn--primary"
          >
            <span class="quick-order-list__button-text">{{- 'sections.quick_order_list.view_cart' | t -}}</span>
          </a>

          <div class="m-quick-order-total__buttons-remove">
            <span class="m-quick-order-total__loader hide">
              {%- render 'icon-loader', loader_classes: 'a-loader--light' -%}
            </span>

            <div
              class="m-quick-order-total__buttons-remove-all m-quick-order-total__remove-button"
              data-action="confirm"
            >
              <button
                class="a-btn a-btn--tertiary a-btn--has-icon"
                type="button"
                aria-label="{{ 'sections.quick_order_list.remove_all' | t }}"
              >
                <span class="text-body">{{ 'sections.quick_order_list.remove_all' | t }}</span>
                {% render 'icon-remove' %}
              </button>
            </div>
          </div>
        </div>
        <span class="m-quick-order-total__message" role="status">
          <span class="m-quick-order-total__message-icon hide">{%- render 'icon-checkmark' -%}</span>
          <span class="m-quick-order-total__message-text"></span>
        </span>
        <span class="o-quick-order-list__error">
          {% comment %} Populated by JS {% endcomment %}
        </span>
      </div>

      <div class="m-quick-order-total__total-items u-text-center">
        <span class="m-quick-order-total__total-count body-fs-lg">{{ items_in_cart }}</span>
        <span>{{ 'sections.quick_order_list.total_items' | t }}</span>
      </div>

      <div class="m-quick-order-total__price">
        <noscript>
          <button
            type="submit"
            class="a-btn a-btn--secondary"
            formnovalidate
            form="quick-order-list"
            aria-label="{{ 'sections.cart.update' | t }}"
          >
            {{ 'sections.cart.update' | t }}
          </button>
        </noscript>

        <div class="m-quick-order-total__product-total">
          <p
            class="m-quick-order-total__subtotal-value body-fs-lg"
            data-total-price="{{ cart | line_items_for: product | sum: 'original_line_price' }}"
          >
            {{ cart | line_items_for: product | sum: 'original_line_price' | money }}
          </p>
          <p class="m-quick-order-total__subtotal-label">{{ 'sections.quick_order_list.product_total' | t }}</p>
        </div>
        <p class="m-quick-order-total__tax-note rte">
          {%- if cart.taxes_included and shop.shipping_policy.body != blank -%}
            {{ 'sections.cart.taxes_included_and_shipping_policy_html' | t: link: shop.shipping_policy.url }}
          {%- elsif cart.taxes_included -%}
            {{ 'sections.cart.taxes_included_but_shipping_at_checkout' | t }}
          {%- elsif shop.shipping_policy.body != blank -%}
            {{ 'sections.cart.taxes_and_shipping_policy_at_checkout_html' | t: link: shop.shipping_policy.url }}
          {%- else -%}
            {{ 'sections.cart.taxes_and_shipping_at_checkout' | t }}
          {%- endif -%}
        </p>
      </div>
    </div>

    <div class="m-quick-order-total__confirmation hide">
      <span class="body-fs-sm">
        {{ 'sections.quick_order_list.remove_all_items_confirmation_html' | t: quantity: items_in_cart }}
      </span>

      <div class="m-quick-order-total__remove-button" data-action="remove">
        <button
          class="m-quick-order-total__button--confirm a-btn a-btn--primary"
          type="button"
          aria-label="{{- 'sections.quick_order_list.remove_all' | t -}}"
        >
          {{- 'sections.quick_order_list.remove_all' | t -}}
        </button>
      </div>
      <div class="m-quick-order-total__remove-button " data-action="cancel">
        <button
          class="m-quick-order-total__button--cancel a-btn a-btn--tertiary"
          type="button"
          aria-label="{{- 'sections.quick_order_list.cancel' | t -}}"
        >
          {{- 'sections.quick_order_list.cancel' | t -}}
        </button>
      </div>
    </div>
  </div>
</div>
