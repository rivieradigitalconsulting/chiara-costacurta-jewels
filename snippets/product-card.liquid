{%- liquid
  assign card_product = card_product
  assign padded_content = padded_content
  assign aspect_ratio_class = 'a-img__ratio--' | append: settings.product_card_image_ratio
  assign show_badges = settings.product_card_show_badges

  unless placeholder_product
    assign show_quick_add = settings.product_card_enable_quick_add
  endunless

  assign hide_loader_on_first_image = true
  assign has_image_slider = false
  assign force_image_slide_disable = force_image_slide_disable

  assign section_id = section_id
  assign combined_section_id = section_id | append: card_product.id

  assign hover_behaviour = settings.product_hover_behavior
  assign show_secondary_image = false
  assign enable_image_slider = false

  if hover_behaviour == 'image'
    assign show_secondary_image = true
  endif

  if hover_behaviour == 'slider'
    assign enable_image_slider = true
  endif

  if card_product.images.size > 1 and enable_image_slider
    assign has_image_slider = true
  endif

  if force_image_slide_disable
    assign has_image_slider = false
  endif

  assign use_variant = false

  assign fetch_priority = 'auto'
  assign loading = 'lazy'

  if section.index == 1
    assign fetch_priority = 'high'
    assign loading = 'eager'
  endif

  assign widths = '165, 360, 535, 750, 1070, 1500'

  assign images_background = settings.card_images_background
  assign card_text_size_mobile = settings.card_text_size_mobile
  assign card_text_size_desktop = settings.card_text_size_desktop
  assign card_text_line_height = settings.card_text_line_height
  assign card_collection_color = settings.card_collection_color
  assign card_description_color = settings.card_description_color
  assign show_collection = false
  if template.name == 'collection' and collection.metafields.plp.show_collection == true
    assign show_collection = true
  endif
-%}

{%- capture sizes -%}
    (min-width: 750px) calc((100vw) / 2), calc((100vw) / 2),
{%- endcapture -%}

{%- capture slider_options -%}
  {
    "direction": "horizontal",
    "slidesPerView": 1,
    "speed": 600,
    "loop": true,
    "autoHeight": false,
    "lazyPreloadPrevNext": 2,
    "navigation": {
      "nextEl": ".swiper-button-next",
      "prevEl": ".swiper-button-prev"
    }
  }
{%- endcapture -%}

<div class="m-product-card {% if settings.enable_animation %}js-animation a-animation a-animation--fade-up{% endif %}">
  {%- unless show_quick_add -%}
    <a href="{{ card_product.url | within: collection }}" class="m-product-card__url">
  {%- endunless -%}

  <div class="m-product-card__media {% if show_quick_add %}quick-add{% endif %} {% if card_product.media[1] != nil and show_secondary_image %}show-secondary-image{% endif %}">
    {%- if show_quick_add -%}
      <a href="{{ card_product.url | within: collection }}" class="m-product-card__url">
    {%- endif -%}
    <div class="m-product-card__image {% if has_image_slider %}m-product-card__image-slider js-product-card-images m-swiper swiper{% endif %}">
      {%- if card_product.featured_media -%}
        {%- if has_image_slider -%}
          {%- render 'product-card-images',
            card_product: card_product,
            aspect_ratio_class: aspect_ratio_class,
            hide_loader_on_first_image: hide_loader_on_first_image,
            loading: loading
          -%}
        {%- else -%}
          {{
            card_product.featured_media
            | image_url: width: 800
            | image_tag:
              class: aspect_ratio_class,
              loading: loading,
              sizes: sizes,
              widths: widths,
              fetchpriority: fetch_priority
          }}
          {%- if card_product.media[1] != null and show_secondary_image -%}
            {{
              card_product.media[1]
              | image_url: width: 800
              | image_tag:
                class: aspect_ratio_class,
                loading: 'lazy',
                sizes: sizes,
                widths: widths,
                fetchpriority: fetch_priority
            }}
          {%- endif -%}
        {%- endif -%}
      {%- else -%}
        {%- assign placeholder_classes = aspect_ratio_class | append: ' a-placeholder-media' -%}
        {{ placeholder_media | placeholder_svg_tag: placeholder_classes }}
      {%- endif -%}
    </div>
    {%- if has_image_slider -%}
      <script type="application/json" data-swiper>
        {{ slider_options | strip_newlines | remove: " " }}
      </script>
    {%- endif -%}
    {%- if show_quick_add -%}
      </a>
    {% endif %}
    {%- if show_quick_add -%}
      {%- render 'product-card-quick-add', card_product: card_product, section_id: section_id -%}
    {% endif %}

    {%- if show_badges -%}
      <div class="m-product-card__badges">
        {%- render 'product-badge', product: card_product -%}
      </div>
    {%- endif -%}
  </div>

  {%- if show_quick_add -%}
    <a href="{{ card_product.url | within: collection }}" class="m-product-card__url">
  {%- endif -%}
  <div class="m-product-card__content {% if padded_content %}m-product-card__content--padded{% endif %} u-text-{{ settings.product_card_alignment }}">
    {%- if card_product.metafields.pdp.collezione.value != blank and show_collection -%}
      <div class="m-product-card__collection">
        {{ card_product.metafields.pdp.collezione.value | first }}
      </div>
    {%- endif -%}
    <h3 class="m-product-card__heading product-title" {{ block.shopify_attributes }}>
      {%- if placeholder_product -%}
        {{ 'products.product.default.product_title' | t }}
      {%- else -%}
        {{ card_product.title | escape }}
      {%- endif -%}
    </h3>
    {%- if card_product.metafields.pdp.descrizione_breve != blank -%}
      <div class="m-product-card__description">
        {{ card_product.metafields.pdp.descrizione_breve }}
      </div>
    {%- endif -%}
    <div class="m-product-card__price" id="price-{{ combined_section_id }}">
      {%- render 'price', product: card_product, price_class: 'm-price--sm', use_variant: use_variant -%}
    </div>
  </div>
  {%- if show_quick_add -%}
    </a>
  {%- endif -%}
  {%- unless show_quick_add -%}
    </a>
  {%- endunless -%}
</div>

{% style %}
  .m-product-card__image .swiper-slide, .m-product-card__image {
    background-color: {{ images_background }};
  }
  .m-product-card__image img {
    mix-blend-mode: multiply;
  }

  .m-product-card__content * {
    font-size: {{ card_text_size_mobile }}px;
    line-height: {{ settings.card_text_line_height | divided_by: 10.0 }};
  }

  @media screen and (min-width: 768px) {
    .m-product-card__content * {
      font-size: {{ card_text_size_desktop }}px;
    }
  }

  .m-product-card__collection {
    color: {{ card_collection_color }};
    text-transform: uppercase;
  }

  .m-product-card__description {
    color: {{ card_description_color }};
  }
{% endstyle %}
