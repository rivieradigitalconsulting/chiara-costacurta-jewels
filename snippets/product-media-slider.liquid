{%- liquid
  assign ratio = ratio
  assign hide_thumbs_mobile = hide_thumbs_mobile
  assign enable_autoplay_video_looping = enable_autoplay_video_looping
  assign enable_zoom = enable_zoom
  assign selected_or_first_featured_media = product.selected_or_first_available_variant.featured_media
-%}

<div class="m-product-media m-product-media--slider m-product-media--ratio-{{ratio}}">
  <div class="m-product-media__main-slider m-swiper js-product-media-items swiper">
    <div
      class="swiper-wrapper"
      {% if enable_zoom %}
        id="product-media-zoom"
      {% endif %}
    >
      {%- liquid
        if selected_or_first_featured_media != null
          render 'product-media-item', media: selected_or_first_featured_media, ratio: ratio, xr_button: true, enable_autoplay_video_looping: enable_autoplay_video_looping, enable_zoom: enable_zoom, enable_lazy_load: false
        endif

        for media in product.media
          assign lazy_load = true

          if forloop.index == 1
            assign lazy_load = false
          endif

          unless selected_or_first_featured_media.id == media.id
            render 'product-media-item', media: media, ratio: ratio, xr_button: true, enable_autoplay_video_looping: enable_autoplay_video_looping, enable_zoom: enable_zoom, enable_lazy_load: lazy_load
          endunless
        endfor
      -%}
    </div>
    {%- if product.media.size > 1 -%}
      <div class="swiper-button-next m-swiper__arrow m-swiper__arrow--next">
        {%- render 'icon-arrow-right' -%}
      </div>
      <div class="swiper-button-prev m-swiper__arrow m-swiper__arrow--prev">
        {%- render 'icon-arrow-left' -%}
      </div>
    {%- endif -%}
  </div>
  <div class="m-product-media__thumbs {% if hide_thumbs_mobile %}a-hide--mobile{% endif %} js-product-media-thumbs swiper">
    <div class="swiper-wrapper">
      {%- assign widths = '165, 360, 535, 750, 1070, 1500' -%}
      {%- capture sizes -%}
        (min-width: 750px) calc((100vw) / 2), calc((100vw) / 2)
      {%- endcapture -%}
      {%- if selected_or_first_featured_media != null -%}
        <div
          class="m-product-media__thumb swiper-slide"
          data-media-id="{{ selected_or_first_featured_media.id }}"
        >
          {{
            selected_or_first_featured_media.preview_image
            | image_url: width: 180, height: 180
            | image_tag: class: ratio_class, loading: 'lazy', sizes: sizes, widths: widths, fetchpriority: 'auto'
          }}
        </div>
      {%- endif -%}
      {% for media in product.media %}
        {%- unless selected_or_first_featured_media.id == media.id -%}
          <div
            class="m-product-media__thumb swiper-slide"
            data-media-id="{{ media.id }}"
          >
            {{
              media.preview_image
              | image_url: width: 180, height: 180
              | image_tag: class: ratio_class, loading: 'lazy', sizes: sizes, widths: widths, fetchpriority: 'auto'
            }}
          </div>
        {%- endunless -%}
      {% endfor %}
    </div>
  </div>
</div>
