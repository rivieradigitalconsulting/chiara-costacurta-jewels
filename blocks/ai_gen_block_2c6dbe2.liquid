{% doc %}
  @prompt
    Generami un blocco di testo, che collego a un Metafield. Se il blocco è vuoto e non valorizzato, allora il blocco non appare. Possibilità di inserire un rich text. su mobile la larghezza si adatta al contenuto di pagina, con i bordi della pagina, su desktop decido io quanto larga la colonna di testo deve essere. Per ogni dispositivo devo poter scegliere margin top e bottom , fermo, non darmi metafield, dammi un tezo a cui posso collegare sorgente dinamica, mi devi far scegliere che giustifica il testo abbia e la dimensione per ogni device, dammi anche la possibilità di gestirmi interlinea per entrambi i dispositivi
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-dynamic-text-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding-left: 20px;
    padding-right: 20px;
    margin-top: {{ block.settings.margin_top_mobile }}px;
    margin-bottom: {{ block.settings.margin_bottom_mobile }}px;
  }

  .ai-dynamic-text-content-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.font_size_mobile }}px;
    line-height: {{ block.settings.line_height_mobile }};
    text-align: {{ block.settings.text_align_mobile }};
  }

  .ai-dynamic-text-content-{{ ai_gen_id }} p {
    margin: 0 0 1em 0;
  }

  .ai-dynamic-text-content-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  @media screen and (min-width: 750px) {
    .ai-dynamic-text-{{ ai_gen_id }} {
      width: {{ block.settings.desktop_width_percent }}%;
      margin-left: auto;
      margin-right: auto;
      margin-top: {{ block.settings.margin_top_desktop }}px;
      margin-bottom: {{ block.settings.margin_bottom_desktop }}px;
    }

    .ai-dynamic-text-content-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size_desktop }}px;
      line-height: {{ block.settings.line_height_desktop }};
      text-align: {{ block.settings.text_align_desktop }};
    }
  }
{% endstyle %}

{% if block.settings.text != blank %}
  <div class="ai-dynamic-text-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
    <div class="ai-dynamic-text-content-{{ ai_gen_id }}">
      {{ block.settings.text }}
    </div>
  </div>
{% endif %}

